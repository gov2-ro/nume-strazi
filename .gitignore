_obsolete
*/_obsolete*
.playwright-mcp/*
data/*
# Generated database — rebuild with build_db.py
data/streets.db
*.code-workspace
# Source registry files (public data, but large — download separately, see README)
data/reference/

# GIS assets (future)
data/gis/

# Curation CSVs are the authoritative record for post-rebuild restore
# (see CLAUDE.md Common Commands) — track all of them, including the
# LLM-classified batches (not reliably regeneratable — LLM output varies
# run to run) and the unclassified.csv export (cheap, useful as a snapshot).
!data/curation/
!data/curation/*.csv

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Static site build output. Exceptions: dist/filter/, dist/browser/, dist/_assets/
# are source (not generated). dist/streets.db is a build artifact — rebuild with
# tools/build_dist_db.py before deploying.
dist/*
!dist/filter/
!dist/browser/
!dist/_assets/

# Claude Code superpowers
.superpowers/
