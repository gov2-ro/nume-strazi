{# templates/index.html.j2 — primary (dense / atlas) layout #}
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cum ne numim străzile · variantă densă</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3"></script>
  <script>
const DATA_S2 = {{ section2 | tojson }};
const DATA_S3 = {{ section3 | tojson }};
const DATA_S4 = {{ section4 | tojson }};
const DATA_S5 = {{ section5 | tojson }};
const DATA_S6 = {{ section6 | tojson }};
const DATA_S8 = {{ section8 | tojson }};
  </script>
  <style>
:root {
  --bg: #FAF8F3;
  --ink: #15171A;
  --muted: #6E6E70;
  --rule: #DDDCD7;
  --wash: #EEEAE0;
  --accent: #C04F35;
  --plaque: #0E4D92;
  --sans: 'Inter', system-ui, sans-serif;
  --street: 'Barlow Semi Condensed', 'Inter', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}

/* Nav */
.site-nav {
  position: sticky; top: 0; z-index: 100;
  background: var(--bg);
  border-bottom: 1px solid var(--rule);
  padding: 8px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--sans);
  font-size: 11px;
  letter-spacing: .06em;
}
.site-nav .brand {
  font-weight: 600;
  color: var(--ink);
  letter-spacing: .12em;
  text-transform: uppercase;
  text-decoration: none;
}
.site-nav nav { display: flex; gap: 18px; }
.site-nav nav a { color: var(--muted); text-decoration: none; }
.site-nav nav a:hover { color: var(--ink); }

/* Stats widget — 4-column dashboard band under the nav.
   Breaks to 2 columns at ≤1024px, single column at ≤640px. */
.statbar {
  background: #F2EDE0;
  border-bottom: 1px solid var(--rule);
  padding: 18px 24px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.3fr;
  gap: 32px;
  align-items: center;
}
.statbar .group { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.statbar .group-label {
  font-family: var(--sans);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .18em;
  color: var(--muted);
  font-weight: 600;
}
.statbar .v {
  font-family: var(--street);
  font-weight: 700;
  font-size: 22px;
  color: var(--ink);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.statbar .v .u {
  font-size: 12px; color: var(--muted);
  margin-left: 2px; font-weight: 600;
}
.statbar .l {
  font-family: var(--sans);
  font-size: 9.5px;
  text-transform: uppercase;
  letter-spacing: .14em;
  color: var(--muted);
  margin-top: 3px;
}
.statbar .accent { color: var(--accent); }

.statbar .scale-stack { display: flex; flex-direction: column; gap: 6px; }
.statbar .scale-stack .item { display: flex; align-items: baseline; gap: 10px; }
.statbar .scale-stack .item .l { margin-top: 0; }

.statbar .tema-row, .statbar .gen-row { display: flex; align-items: baseline; gap: 6px; }
.statbar .gen-row .frac {
  font-family: var(--sans); font-size: 11.5px; color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.statbar .minibar {
  display: flex; height: 6px; border-radius: 1px; overflow: hidden;
  background: rgba(0,0,0,.06); margin-top: 2px;
}

.statbar .top-pair { display: flex; flex-direction: column; gap: 6px; }
.statbar .top-pair .row {
  display: flex; align-items: baseline; gap: 8px;
  font-family: var(--sans);
}
.statbar .top-pair .prefix {
  font-size: 9.5px; text-transform: uppercase; letter-spacing: .14em;
  color: var(--muted); font-weight: 600; min-width: 22px;
}
.statbar .top-pair .name { font-size: 13.5px; font-weight: 600; color: var(--ink); }
.statbar .top-pair .cnt {
  font-family: var(--street); font-weight: 700;
  font-size: 13px; color: var(--muted);
  font-variant-numeric: tabular-nums; margin-left: auto;
}
.statbar .top-pair .cnt .u { font-size: 10px; color: var(--muted); margin-left: 2px; }

@media (max-width: 1024px) {
  .statbar { grid-template-columns: 1fr 1fr; row-gap: 22px; padding: 16px 20px; }
}
@media (max-width: 640px) {
  .statbar { grid-template-columns: 1fr; row-gap: 18px; padding: 14px 16px; gap: 18px; }
}

/* 12-col panel grid */
.dash-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 1px; background: var(--rule);
  max-width: 1600px; margin: 0 auto;
}
.panel {
  background: var(--bg);
  padding: 12px 14px 10px;
  grid-column: span 6;
  min-width: 0;
}
.panel.s4  { grid-column: span 4; }
.panel.s6  { grid-column: span 6; }
.panel.s8  { grid-column: span 8; }
.panel.s12 { grid-column: span 12; }

/* Panel header */
.panel-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid var(--rule);
  gap: 10px; flex-wrap: wrap;
}
.panel-label {
  font-family: var(--sans); font-size: 9.5px; letter-spacing: .14em;
  text-transform: uppercase; font-weight: 600; color: var(--muted);
}
.panel-meta {
  font-family: var(--sans); font-size: 10.5px; color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.panel-caption {
  font-family: var(--sans); font-size: 11px; color: var(--muted);
  margin-top: 8px; line-height: 1.45;
}

.kicker {
  font-family: var(--sans);
  font-size: 9.5px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 500;
  margin-bottom: 8px;
}

/* Chip toggles */
.chip-row {
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  margin-bottom: 10px; padding-bottom: 8px;
  border-bottom: 1px solid var(--rule);
  font-family: var(--sans); font-size: 11px;
}
.chip-row .label {
  letter-spacing: .12em; text-transform: uppercase;
  font-weight: 500; color: var(--muted);
}
.chip {
  font-family: var(--sans); font-size: 11px;
  color: var(--muted);
  padding: 3px 10px;
  border: 1px solid var(--rule); border-radius: 999px;
  background: transparent; cursor: pointer;
  transition: background .15s, color .15s;
}
.chip:hover, .chip.active {
  color: var(--bg); background: var(--ink); border-color: var(--ink);
}

/* Județ picker for the top-frequent panel */
.s2-judet-pick {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--sans); font-size: 11px;
}
.s2-judet-pick label {
  letter-spacing: .12em; text-transform: uppercase;
  font-weight: 500; color: var(--muted);
}
.s2-judet-pick select {
  font-family: var(--sans); font-size: 11.5px;
  color: var(--ink); background: var(--bg);
  border: 1px solid var(--rule); border-radius: 3px;
  padding: 4px 24px 4px 10px;
  -webkit-appearance: none; -moz-appearance: none; appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--muted) 50%),
    linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position: calc(100% - 12px) 50%, calc(100% - 8px) 50%;
  background-size: 4px 4px, 4px 4px;
  background-repeat: no-repeat;
  cursor: pointer; outline: none;
  min-width: 200px;
}
.s2-judet-pick select:focus { border-color: var(--ink); }

/* Tag pills */
.tag {
  font-family: var(--sans); font-size: 9.5px;
  color: var(--muted); background: var(--wash);
  padding: 1px 6px; border-radius: 999px;
  margin-left: 6px; vertical-align: middle;
}
.tag.person { background: #F4E8E5; color: #B8432F; }

/* Rank list — generic */
.rank-list { display: flex; flex-direction: column; }
.rank-row {
  display: grid;
  align-items: center; gap: 10px;
  padding: 4px 0;
  border-bottom: 1px solid var(--wash);
  break-inside: avoid;
}
.rank-row:last-child { border-bottom: none; }
.rank-num {
  font-family: var(--sans); font-size: 10.5px;
  color: var(--muted); text-align: right;
  font-variant-numeric: tabular-nums;
}
/* Street names rendered as Romanian street-sign plaques:
   white lettering on signal-blue (the RO street-sign convention),
   with a faint inset top highlight and a soft drop shadow so the
   plate reads as slightly raised. Type carries a dual text-shadow
   (subtle top darkening + soft cast below) for an engraved feel.
   `width: max-content` + `justify-self: start` keeps plaques sized to
   their content even inside `1fr` grid columns; `max-width: 100%` lets
   the longest names truncate cleanly with an ellipsis. */
.rank-name, .street-tag {
  font-family: var(--street);
  font-weight: 700;
  font-size: 12.5px;
  letter-spacing: .045em;
  display: inline-block;
  padding: 2px 9px;
  background: var(--plaque);
  color: #FFFFFF;
  border: none;
  border-radius: 2px;
  text-shadow:
    0 -0.5px 0 rgba(0, 0, 0, .30),
    0 1px 1.5px rgba(0, 0, 0, .50);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .12),
    0 2px 3px rgba(0, 0, 0, .26);
  line-height: 1.25;
  vertical-align: middle;
  width: max-content;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  justify-self: start;
}
.street-tag.small {
  font-size: 11.5px;
  padding: 1px 7px;
}
/* Person names: clean, bold sans, no plaque */
.rank-name.person {
  display: inline;
  padding: 0; border: none; background: transparent; border-radius: 0;
  font-family: var(--sans); font-weight: 600;
  font-size: 12.5px; letter-spacing: 0;
  color: var(--ink);
  text-shadow: none;
  box-shadow: none;
  max-width: none; overflow: visible;
  width: auto;
  justify-self: auto;
}
.rank-count {
  font-family: var(--sans); font-size: 11.5px;
  color: var(--muted); text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 2-column rank list inside a wide panel.
   Override display:block so column-count works (flex containers ignore multicol). */
.rank-2col {
  display: block;
  column-count: 2; column-gap: 32px;
  column-rule: 1px solid var(--rule);
}
.rank-2col .rank-row { break-inside: avoid; }

/* Per-section row templates */
.s2-list .rank-row     { grid-template-columns: 24px minmax(0, 1fr) 110px 48px; gap: 8px; }
.s3-tower .rank-row    { grid-template-columns: minmax(0, 1fr) minmax(60px, 1fr) 38px; }
.s4-list .rank-row     { grid-template-columns: minmax(0, 1fr) minmax(60px, 1fr) 60px 56px; }

/* Row cell containing the street-name plaque and (optionally) a category tag */
.name-cell {
  display: flex; align-items: center; gap: 6px;
  min-width: 0;
  overflow: hidden;
}
.name-cell .rank-name { flex: 0 1 auto; min-width: 0; }
.name-cell .tag { flex: 0 0 auto; }

/* Contest row: fixed plaque column so bars share a left edge across rows.
   The 140px column fits every label we ship (longest ~ "Trandafirilor",
   "Privighetorii", "Răsăritului") at the small plaque size. */
.contest-row {
  display: grid;
  grid-template-columns: 14px 140px minmax(50px, 1fr) 36px;
  gap: 8px;
  align-items: center;
  padding: 3px 0;
}
.contest-row + .contest-row { border-top: 1px solid var(--wash); }
.contest-row .rank-num-mini {
  font-family: var(--sans); font-size: 9.5px;
  color: var(--muted); text-align: right;
  font-variant-numeric: tabular-nums;
}
.contest-row .rank-count-mini {
  font-family: var(--sans); font-size: 10.5px;
  color: var(--muted); text-align: right;
  font-variant-numeric: tabular-nums;
}

/* Internal 3-col grids inside wide panels (amprente, conteste). Collapse at narrow widths. */
.subgrid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1px;
  background: var(--rule);
  border: 1px solid var(--rule);
}

/* Bars */
.bar-wrap {
  height: 3px; background: var(--wash);
  border-radius: 1px; position: relative;
}
.bar {
  position: absolute; left: 0; top: 0;
  height: 100%; border-radius: 1px;
  background: var(--ink); opacity: .4;
}
.bar.accent { background: var(--accent); opacity: .65; }
.bar.female { background: var(--accent); opacity: .5; }

/* Display numbers (sans, tabular) */
.display-num {
  font-family: var(--sans); font-weight: 600;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.02em; line-height: 1;
}

/* Map fingerprint right rail */
.map-grid {
  display: grid;
  grid-template-columns: 8fr 4fr;
  gap: 24px;
}
.map-grid .fingerprint {
  border-left: 1px solid var(--rule);
  padding-left: 18px;
}

/* Tablet: collapse aggressive 3-up to 2-up, stack map, soften subgrids */
@media (max-width: 1024px) {
  .panel.s4, .panel.s6, .panel.s8 { grid-column: span 6; }
  .panel.s12 { grid-column: span 12; }
  .map-grid { grid-template-columns: 1fr; }
  .map-grid .fingerprint {
    border-left: none;
    border-top: 1px solid var(--rule);
    padding-left: 0;
    padding-top: 14px;
    margin-top: 4px;
  }
  .subgrid-3 { grid-template-columns: 1fr 1fr; }
}

/* Mobile: single column, single-col rank lists, fully collapsed subgrids */
@media (max-width: 640px) {
  .panel { grid-column: span 12 !important; padding: 10px 12px 8px; }
  .dash-grid { gap: 0; max-width: 100%; }
  .rank-2col { column-count: 1; column-rule: none; }
  .site-nav nav { display: none; }
  .subgrid-3 { grid-template-columns: 1fr; }
}
  </style>
</head>
<body>

<nav class="site-nav">
  <a href="#cele-mai-intalnite" class="brand">Cum ne numim străzile</a>
  <nav>
    <a href="#cele-mai-intalnite">Cele mai întâlnite</a>
    <a href="#tematica">Tematică</a>
    <a href="#pe-cine-onoram">Pe cine onorăm</a>
    <a href="#recunoastere">Recunoaștere</a>
    <a href="#harta">Harta</a>
    <a href="#renumiri">Renumiri</a>
    <a href="#curiozitati">Curiozități</a>
  </nav>
</nav>

{# Stats widget — V3b · responsive 4→2→1 columns #}
{% set total_gendered = section1.total_persons_m + section1.total_persons_f %}
{% set male_pct = (section1.total_persons_m / total_gendered * 100) | round | int if total_gendered else 0 %}
{% set female_pct = 100 - male_pct if total_gendered else 0 %}
{% set total_persons = section3.total_m + section3.total_f %}
{# Tematică: top category as headline, top-4 named, remainder grouped as "altele".
   Colours match the conic-gradient in the Repartiție tematică panel below. #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_palette = ['#C04F35','#A0826A','#8BA888','#6E6E70','#B8A090','#3A3A3D','#DDDCD7'] %}
{% set theme_ro = {
  'natură':'natură','persoană':'persoane','concept / abstract':'abstract',
  'ideologic':'ideologic','dată / sărbătoare':'date','religios':'religios'
} %}
{% set top4 = section5.theme_dist[:4] %}
{% set rest = section5.theme_dist[4:] %}
{% set rest_count = rest | sum(attribute='count') %}
{% set lead = section5.theme_dist[0] %}
{% set lead_pct = (lead.count / theme_total * 100) | round | int %}
<div class="statbar">

  <div class="group">
    <div class="group-label">Scară</div>
    <div class="scale-stack">
      <div class="item">
        <div class="v">{{ "{:,.0f}".format(section1.total_streets).replace(",", ".") }}</div>
        <div class="l">Adrese</div>
      </div>
      <div class="item">
        <div class="v">{{ total_persons }}</div>
        <div class="l">Persoane onorate</div>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-label">Tematică</div>
    <div class="tema-row">
      <div class="v">{{ lead_pct }}<span class="u">% {{ theme_ro[lead.category] | default(lead.category) }}</span></div>
    </div>
    <div class="minibar">
      {% for t in top4 %}
        {% set pct = (t.count / theme_total * 100) %}
        <div style="width:{{ pct }}%;background:{{ theme_palette[loop.index0] }};"></div>
      {% endfor %}
      {% if rest_count %}
        {% set rest_pct = (rest_count / theme_total * 100) %}
        <div style="width:{{ rest_pct }}%;background:{{ theme_palette[4] }};"></div>
      {% endif %}
    </div>
    <div class="l">
      {% for t in top4[1:] %}
        {% set pct = (t.count / theme_total * 100) | round | int %}
        {{ theme_ro[t.category] | default(t.category) }} <strong style="color:var(--ink);">{{ pct }}%</strong>{{ ' · ' if not loop.last }}
      {% endfor %}
    </div>
  </div>

  <div class="group">
    <div class="group-label">Repartiție pe gen</div>
    <div class="gen-row">
      <div class="v">{{ male_pct }}<span class="u">% B</span></div>
      <div class="frac">/ <span class="accent" style="font-weight:600;">{{ female_pct }}% F</span></div>
    </div>
    <div class="minibar">
      <div style="width:{{ male_pct }}%;background:rgba(0,0,0,.42);"></div>
      <div style="width:{{ female_pct }}%;background:var(--accent);"></div>
    </div>
    <div class="l">Persoane onorate, M vs F</div>
  </div>

  <div class="group">
    <div class="group-label">Cei mai des onorați</div>
    <div class="top-pair">
      {% if section1.top_men %}
      <div class="row">
        <span class="prefix">#1 B</span>
        <span class="name">{{ section1.top_men[0].full_name }}</span>
        <span class="cnt">{{ section1.top_men[0].street_count }}<span class="u">str.</span></span>
      </div>
      {% endif %}
      {% if section1.top_women %}
      <div class="row">
        <span class="prefix">#1 F</span>
        <span class="name">{{ section1.top_women[0].full_name }}</span>
        <span class="cnt">{{ section1.top_women[0].street_count }}<span class="u">str.</span></span>
      </div>
      {% endif %}
    </div>
  </div>

</div>

<div class="dash-grid">

{# PANEL: CELE MAI FRECVENTE (s12, 2-col rank list) #}
<div class="panel s12" id="cele-mai-intalnite">
  <div class="panel-header">
    <span class="panel-label">Cele mai frecvente · Top 30</span>
    <div class="s2-judet-pick">
      <label for="s2-judet-select">Județ</label>
      <select id="s2-judet-select">
        <option value="all">Toate județele</option>
        {# Options populated by JS #}
      </select>
    </div>
  </div>
  <div class="rank-list rank-2col s2-list" id="s2-list">
    {# Populated by JS #}
  </div>
  <div style="font-family:var(--sans);font-size:10.5px;color:var(--muted);padding:8px 0 0;" id="s2-footer"></div>
</div>

{# PANEL: REPARTIȚIE TEMATICĂ (s4) #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_colors = ['#C04F35','#A0826A','#8BA888','#6E6E70','#B8A090','#3A3A3D','#DDDCD7'] %}
{% set ns = namespace(cumulative=0) %}
<div class="panel s4" id="tematica">
  <div class="panel-header">
    <span class="panel-label">Repartiție tematică</span>
    <span class="panel-meta">{{ "{:,.0f}".format(theme_total).replace(",", ".") }} clasif.</span>
  </div>
  <div style="display:flex;gap:18px;align-items:center;">
    <div style="position:relative;width:96px;height:96px;flex-shrink:0;">
      <div style="width:96px;height:96px;border-radius:50%;background:conic-gradient(
        {% for t in section5.theme_dist %}
        {% set pct = (t.count / theme_total * 100) | round(1) %}
        {{ theme_colors[loop.index0 % theme_colors|length] }} {{ ns.cumulative }}% {{ ns.cumulative + pct }}%{{ ',' if not loop.last }}
        {% set ns.cumulative = ns.cumulative + pct %}
        {% endfor %}
      );"></div>
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;background:var(--bg);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">
        <div class="display-num" style="font-size:15px;">{{ "{:,.0f}".format(theme_total).replace(",", ".") }}</div>
        <div style="font-family:var(--sans);font-size:8.5px;color:var(--muted);letter-spacing:.06em;">total</div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:5px;flex:1;min-width:0;">
      {% for t in section5.theme_dist %}
      {% set pct = (t.count / theme_total * 100) | round(1) %}
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:8px;height:8px;border-radius:1px;background:{{ theme_colors[loop.index0 % theme_colors|length] }};flex-shrink:0;"></div>
        <span style="font-family:var(--sans);font-size:11.5px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ t.category }}</span>
        <span style="font-family:var(--sans);font-size:11.5px;font-weight:600;font-variant-numeric:tabular-nums;">{{ pct }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# PANEL: SUBTIPURI NATURĂ (s4) #}
{% set nature_ro = {
  'flower':'flori','tree':'copaci','water':'apă','plant':'plante',
  'bird':'păsări','sky':'cer','geography':'geografie','forest':'pădure',
  'meadow':'câmpie','season':'anotimpuri','animal':'animale',
  'weather':'vreme','fruit':'fructe','field':'câmp','hill':'deal',
  'orchard':'livadă','valley':'vale','peak':'vârf','mountain':'munte',
  'mountain_peak':'vârf de munte'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label">Subtipuri · Natură</span>
  </div>
  {% set max_n = section5.nature_subtypes[0].n if section5.nature_subtypes else 1 %}
  {% for row in section5.nature_subtypes %}
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
    <span style="font-family:var(--sans);font-size:11.5px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ nature_ro.get(row.nature_type, row.nature_type) }}</span>
    <div class="bar-wrap" style="width:80px;"><div class="bar" style="width:{{ (row.n / max_n * 100)|int }}%;background:#A0826A;opacity:.7;"></div></div>
    <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);width:26px;text-align:right;font-variant-numeric:tabular-nums;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: TOKENI IDEOLOGICI (s4) #}
{% set ideo_ro = {
  'victory':'victorie','national_day':'zi națională','brotherhood':'frăție',
  'youth':'tinerețe','workers':'muncitori','unification':'unire',
  'triumph':'triumf','solidarity':'solidaritate','revolution':'revoluție',
  'republic':'republică','rebirth':'renaștere','progress':'progres',
  'peace':'pace','liberation':'eliberare','labor':'muncă',
  'independence':'independență','homeland':'patrie','glory':'glorie',
  'freedom':'libertate','fraternity':'frăternitate','equality':'egalitate',
  'emancipation':'emancipare','democracy':'democrație','cooperative':'cooperativă',
  'communist_press':'presă comunistă','commemorative':'comemorativ'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label">Tokeni ideologici</span>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:5px;">
    {% for tok in section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:11px;padding:2px 8px;border:1px solid {{ 'var(--accent)' if tok.n > 30 else 'var(--rule)' }};border-radius:3px;color:{{ '#B8432F' if tok.n > 30 else 'var(--ink)' }};background:{{ '#FDF4F2' if tok.n > 30 else 'transparent' }};">
      {{ ideo_ro.get(tok.token, tok.token) }} <span style="color:var(--muted);font-size:9.5px;margin-left:3px;font-variant-numeric:tabular-nums;">{{ tok.n }}</span>
    </span>
    {% endfor %}
    {% if not section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:11.5px;font-style:italic;color:var(--muted);">Subcategorii în curs de completare.</span>
    {% endif %}
  </div>
</div>

{# PANEL: ECART DE GEN (s4) #}
<div class="panel s4" id="pe-cine-onoram">
  <div class="panel-header">
    <span class="panel-label">Ecart de gen</span>
    <span class="panel-meta">{{ section3.total_m + section3.total_f }} pers.</span>
  </div>
  <div style="display:flex;gap:16px;align-items:start;">
    <div>
      <div style="font-family:var(--sans);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;">Fiecare pătrat = 1 persoană</div>
      <div id="s3-gap-grid" style="display:grid;grid-template-columns:repeat(10,11px);gap:2px;width:130px;"></div>
      <div style="display:flex;gap:10px;margin-top:8px;font-family:var(--sans);font-size:10px;">
        <div style="display:flex;align-items:center;gap:5px;">
          <div style="width:8px;height:8px;border-radius:1px;background:var(--ink)"></div><span style="color:var(--muted)">Bărbat</span>
        </div>
        <div style="display:flex;align-items:center;gap:5px;">
          <div style="width:8px;height:8px;border-radius:1px;background:var(--accent)"></div><span style="color:var(--muted)">Femeie</span>
        </div>
      </div>
    </div>
    <div>
      <div class="display-num" style="font-size:36px;margin-bottom:2px;">
        {{ section3.total_m }}<span style="font-size:20px;color:var(--muted);font-weight:500;">/{{ section3.total_m + section3.total_f }}</span>
      </div>
      <div style="font-family:var(--sans);font-size:10.5px;color:var(--muted);">bărbați din total</div>
    </div>
  </div>
</div>

{# PANEL: PROFESII (s4) #}
{% set prof_ro = {
  'writer':'scriitor','poet':'poet','politician':'politician',
  'voievod':'voievod','revolutionary':'revoluționar','military':'militar',
  'royalty':'rege / regină','scientist':'om de știință','painter':'pictor',
  'ruler':'conducător','historian':'istoric','composer':'compozitor',
  'engineer':'inginer','educator':'pedagog','clergy':'cleric',
  'philosopher':'filosof','actor':'actor','architect':'arhitect',
  'doctor':'medic','economist':'economist','jurist':'jurist',
  'linguist':'lingvist','mathematician':'matematician','lawyer':'avocat'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label">Profesia persoanei onorate</span>
  </div>
  {% set max_prof = section3.profession_dist[0].n if section3.profession_dist else 1 %}
  {% for row in section3.profession_dist %}
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
    <span style="font-family:var(--sans);font-size:11.5px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ prof_ro.get(row.profession, row.profession) }}</span>
    <div class="bar-wrap" style="width:80px;">
      <div class="bar" style="width:{{ (row.n / max_prof * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);width:22px;text-align:right;font-variant-numeric:tabular-nums;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: EPOCI (s4) #}
{% set era_ro = {
  'ancient':'antichitate','medieval':'medieval','premodern':'premodern (1700–1900)',
  '1848':'generația de la 1848','interwar':'interbelic (1900–1947)',
  'communist':'comunism (1947–1989)'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label">Epoca în care a trăit</span>
  </div>
  {% set max_era = section3.era_dist[0].n if section3.era_dist else 1 %}
  {% for row in section3.era_dist %}
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
    <span style="font-family:var(--sans);font-size:11.5px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ era_ro.get(row.era, row.era or 'necunoscută') }}</span>
    <div class="bar-wrap" style="width:80px;">
      <div class="bar" style="width:{{ (row.n / max_era * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);width:22px;text-align:right;font-variant-numeric:tabular-nums;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: TOP PERSOANE (s12, 2-col internal) #}
<div class="panel s12">
  <div class="panel-header">
    <span class="panel-label">Top persoane onorate · număr de străzi</span>
    <span class="panel-meta">{{ section3.top_persons | length }} pers. · • feminin</span>
  </div>
  <div class="rank-list rank-2col s3-tower">
    {% set max_count = section3.top_persons[0].street_count %}
    {% for p in section3.top_persons %}
    <div class="rank-row">
      <span class="rank-name person">
        {{ p.full_name }}{% if p.gender == 'F' %} <span style="display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%;margin-left:4px;vertical-align:middle;"></span>{% endif %}
      </span>
      <div class="bar-wrap">
        <div class="{{ 'bar accent' if loop.first else ('bar female' if p.gender == 'F' else 'bar') }}"
             style="width:{{ (p.street_count / max_count * 100)|int }}%"></div>
      </div>
      <span class="rank-count">{{ p.street_count }}</span>
    </div>
    {% endfor %}
  </div>
</div>

{# PANEL: RECUNOAȘTERE GLOBALĂ (s6) #}
<div class="panel s6" id="recunoastere">
  <div class="panel-header">
    <span class="panel-label">Recunoaștere globală · Wikidata</span>
    <span class="panel-meta">{{ wikidata_total }} persoane</span>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:var(--rule);border:1px solid var(--rule);">
    <div style="background:var(--ink);color:#FAF8F3;padding:12px 12px;">
      <div style="font-family:var(--sans);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--accent);margin-bottom:6px;">Universal</div>
      <div class="display-num" style="font-size:32px;margin-bottom:2px;">{{ section4.tier_counts.universal }}</div>
      <div style="font-family:var(--sans);font-size:9.5px;color:#C9C9CB;">≥ 50 limbi Wikipedia</div>
    </div>
    <div style="background:var(--bg);padding:12px 12px;">
      <div style="font-family:var(--sans);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);margin-bottom:6px;">Național</div>
      <div class="display-num" style="font-size:32px;margin-bottom:2px;">{{ section4.tier_counts.national }}</div>
      <div style="font-family:var(--sans);font-size:9.5px;color:var(--muted);">5–49 limbi</div>
    </div>
    <div style="background:var(--bg);padding:12px 12px;">
      <div style="font-family:var(--sans);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);margin-bottom:6px;">Local</div>
      <div class="display-num" style="font-size:32px;margin-bottom:2px;">{{ section4.tier_counts.local }}</div>
      <div style="font-family:var(--sans);font-size:9.5px;color:var(--muted);">sub 5 limbi</div>
    </div>
  </div>
</div>

{# PANEL: RENUMIRI placeholder (s6) #}
<div class="panel s6" id="renumiri">
  <div class="panel-header">
    <span class="panel-label">Renumiri</span>
  </div>
  <div class="panel-caption">Secțiune în construcție — date indisponibile.</div>
</div>

{# PANEL: NOTORIETATE WIKIPEDIA (s12, 2-col internal) #}
<div class="panel s12">
  <div class="panel-header">
    <span class="panel-label">Notorietate Wikipedia · vizualizări lunare medii · ro.wikipedia.org · 12 luni</span>
  </div>
  <div class="rank-list rank-2col s4-list">
    {% set max_pv = section4.top_pageviews[0].wiki_ro_views if section4.top_pageviews else 1 %}
    {% for p in section4.top_pageviews %}
    <div class="rank-row">
      <span class="rank-name person">{{ p.full_name }}</span>
      <div class="bar-wrap">
        <div class="{{ 'bar accent' if p.wiki_scope == 'universal' else 'bar' }}"
             style="width:{{ (p.wiki_ro_views / max_pv * 100)|int }}%"></div>
      </div>
      <span class="rank-count">{{ "{:,.0f}".format(p.wiki_ro_views).replace(",", ".") }}</span>
      <span class="tag{{ ' person' if p.wiki_scope == 'universal' else '' }}">{{ p.wiki_scope or '—' }}</span>
    </div>
    {% endfor %}
  </div>
</div>

{# PANEL: HARTA (s12, internal 8/4) #}
<div class="panel s12" id="harta">
  <div class="panel-header">
    <span class="panel-label">Harta · statistici pe județ</span>
    <div class="chip-row" id="s6-metric-row" style="margin:0;padding:0;border:none;">
      <span class="label">Vedeți după</span>
      <button class="chip active" data-metric="saint_pct">% sfinți</button>
      <button class="chip" data-metric="numeric_pct">% numere</button>
      <button class="chip" data-metric="female_pct">% femei</button>
    </div>
  </div>
  <div class="map-grid" id="s6-grid">
    <div style="position:relative;">
      <svg id="s6-map" style="width:100%;height:auto;display:block;"></svg>
      <div style="margin-top:10px;display:flex;align-items:center;gap:12px;font-family:var(--sans);font-size:10.5px;color:var(--muted);">
        <span id="s6-scale-min">0%</span>
        <div style="flex:1;height:5px;background:linear-gradient(to right,#F4EFE6 0%,#E8B299 35%,#D27A5C 65%,#A53A22 100%);border-radius:1px;"></div>
        <span id="s6-scale-max" style="font-variant-numeric:tabular-nums;">12%</span>
        <span style="margin-left:10px;" id="s6-scale-label">% străzi cu prefix „Sf."</span>
      </div>
    </div>
    <div class="fingerprint" id="s6-fingerprint">
      <div class="kicker">Amprenta județului</div>
      <p style="font-family:var(--sans);font-size:12px;color:var(--muted);padding-top:20px;">
        Selectați un județ pe hartă.
      </p>
    </div>
  </div>
</div>

{# PANEL: AMPRENTE JUDEȚENE (s12, internal 3-col) #}
<div class="panel s12">
  <div class="panel-header">
    <span class="panel-label">Amprente județene · trei caractere</span>
  </div>
  <div class="subgrid-3">

    {# Most "exclusivist" - judete with most names found nowhere else #}
    <div style="background:var(--bg);padding:12px 14px;">
      <div class="panel-label" style="margin-bottom:6px;">Cele mai exclusiviste</div>
      <div class="panel-caption" style="margin:0 0 8px;">Județe cu cele mai multe nume găsite doar acolo · ≥3 străzi local</div>
      {% set max_d = section8.judet_distinctive[0].n if section8.judet_distinctive else 1 %}
      {% for row in section8.judet_distinctive %}
      <div style="display:flex;align-items:center;gap:8px;padding:3px 0;border-bottom:{{ '1px solid var(--wash)' if not loop.last else 'none' }};">
        <span style="font-family:var(--sans);font-size:9.5px;color:var(--muted);width:14px;text-align:right;font-variant-numeric:tabular-nums;">{{ loop.index }}</span>
        <span style="font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.04em;width:30px;">{{ row.judet }}</span>
        <div class="bar-wrap" style="flex:1;"><div class="bar accent" style="width:{{ (row.n / max_d * 100)|int }}%;"></div></div>
        <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);width:30px;text-align:right;font-variant-numeric:tabular-nums;">{{ row.n }}</span>
      </div>
      {% endfor %}
    </div>

    {# Most "rural-poetic" - highest nature % #}
    <div style="background:var(--bg);padding:12px 14px;">
      <div class="panel-label" style="margin-bottom:6px;">Cele mai «rurale-poetice»</div>
      <div class="panel-caption" style="margin:0 0 8px;">Cota de străzi cu nume din natură (flori, copaci, ape, animale…)</div>
      {% set max_r = section8.judet_rural[0].pct if section8.judet_rural else 1 %}
      {% for row in section8.judet_rural %}
      <div style="display:flex;align-items:center;gap:8px;padding:3px 0;border-bottom:{{ '1px solid var(--wash)' if not loop.last else 'none' }};">
        <span style="font-family:var(--sans);font-size:9.5px;color:var(--muted);width:14px;text-align:right;font-variant-numeric:tabular-nums;">{{ loop.index }}</span>
        <span style="font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.04em;width:30px;">{{ row.judet }}</span>
        <div class="bar-wrap" style="flex:1;"><div class="bar" style="width:{{ (row.pct / max_r * 100)|int }}%;background:#8BA888;opacity:.75;"></div></div>
        <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);width:46px;text-align:right;font-variant-numeric:tabular-nums;">{{ row.pct }}%</span>
      </div>
      {% endfor %}
    </div>

    {# Most ideological #}
    <div style="background:var(--bg);padding:12px 14px;">
      <div class="panel-label" style="margin-bottom:6px;">Cele mai «ideologice»</div>
      <div class="panel-caption" style="margin:0 0 8px;">Cota de străzi cu nume ideologic (libertate, victorie, unire…)</div>
      {% set max_i = section8.judet_ideo[0].pct if section8.judet_ideo else 1 %}
      {% for row in section8.judet_ideo %}
      <div style="display:flex;align-items:center;gap:8px;padding:3px 0;border-bottom:{{ '1px solid var(--wash)' if not loop.last else 'none' }};">
        <span style="font-family:var(--sans);font-size:9.5px;color:var(--muted);width:14px;text-align:right;font-variant-numeric:tabular-nums;">{{ loop.index }}</span>
        <span style="font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.04em;width:30px;">{{ row.judet }}</span>
        <div class="bar-wrap" style="flex:1;"><div class="bar accent" style="width:{{ (row.pct / max_i * 100)|int }}%;"></div></div>
        <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);width:46px;text-align:right;font-variant-numeric:tabular-nums;">{{ row.pct }}%</span>
      </div>
      {% endfor %}
    </div>

  </div>
</div>

{# PANEL: SEMNĂTURI REGIONALE (s6) + CURIOZITĂȚI UNICE NAȚIONALE (s6) #}
<div class="panel s6">
  <div class="panel-header">
    <span class="panel-label">Semnături regionale · ≥80% concentrare într-un județ</span>
    <span class="panel-meta">{{ section8.regional_signatures | length }} nume</span>
  </div>
  <div class="rank-list">
    {% for r in section8.regional_signatures %}
    <div class="rank-row" style="grid-template-columns: minmax(0, 1fr) 30px 70px; gap: 10px;">
      <span class="rank-name">{{ r.display_name }}</span>
      <span style="font-family:var(--sans);font-size:11px;font-weight:600;letter-spacing:.04em;color:var(--ink);text-align:right;">{{ r.judet }}</span>
      <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);text-align:right;font-variant-numeric:tabular-nums;">{{ r.local_total }}/{{ r.national_total }} · {{ r.pct }}%</span>
    </div>
    {% endfor %}
  </div>
</div>

<div class="panel s6" id="curiozitati">
  <div class="panel-header">
    <span class="panel-label">Curiozități unice naționale · doar într-un singur UAT</span>
    <span class="panel-meta">selecție · geografice</span>
  </div>
  <div class="rank-list">
    {% for r in section8.local_uniques %}
    <div class="rank-row" style="grid-template-columns: minmax(0, 1fr) auto; gap: 10px;">
      <span class="rank-name">{{ r.display_name }}</span>
      <span style="font-family:var(--sans);font-size:10.5px;color:var(--muted);text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px;">{{ r.uat | title }} · <strong style="color:var(--ink);font-weight:600;letter-spacing:.04em;">{{ r.judet }}</strong></span>
    </div>
    {% endfor %}
  </div>
</div>

{# PANEL: CONTESTE TEMATICE (s12, internal 3-col × 2-row grid) #}
{% set contest_labels = {
  'animals': 'Animale',
  'flowers': 'Flori',
  'trees':   'Copaci',
  'birds':   'Păsări',
  'sky':     'Cer · lumină',
  'trades':  'Meserii',
} %}
{% set contest_order = ['flowers', 'trees', 'birds', 'animals', 'sky', 'trades'] %}
<div class="panel s12">
  <div class="panel-header">
    <span class="panel-label">Conteste tematice · top 7 din fiecare familie</span>
  </div>
  <div class="subgrid-3">
    {% for key in contest_order %}
    {% set entries = section8.contests[key] %}
    <div style="background:var(--bg);padding:12px 14px;">
      <div class="panel-label" style="margin-bottom:8px;">{{ contest_labels[key] }}</div>
      {% if entries %}
        {% set max_e = entries[0].n %}
        {% for row in entries %}
        <div class="contest-row">
          <span class="rank-num-mini">{{ loop.index }}</span>
          <span class="street-tag small">{{ row.label }}</span>
          <div class="bar-wrap"><div class="bar" style="width:{{ (row.n / max_e * 100)|int }}%;"></div></div>
          <span class="rank-count-mini">{{ row.n }}</span>
        </div>
        {% endfor %}
      {% else %}
        <p style="font-family:var(--sans);font-size:11.5px;font-style:italic;color:var(--muted);">Date în curs de completare.</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>


</div>{# end .dash-grid #}

{# FOOTER #}
<footer style="background:var(--ink);color:#FAF8F3;padding:20px 24px;">
  <div style="max-width:1600px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr 1fr;gap:32px;">
    <div>
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--accent);margin-bottom:6px;">Despre date</div>
      <p style="font-family:var(--sans);font-size:12px;line-height:1.55;color:#C9C9CB;">
        Registrul Secțiilor de Vot, Autoritatea Electorală Permanentă, 14.05.2025.
        Descriere adrese cu alegători înregistrați.
      </p>
    </div>
    <div>
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--accent);margin-bottom:6px;">Metodologie</div>
      <p style="font-family:var(--sans);font-size:12px;line-height:1.55;color:#C9C9CB;">
        Clasificare: curation manual + LLM batch (Claude Haiku + Gemini).
        Recunoaștere: Wikidata + Wikipedia pageviews.
        Harta: GeoJSON județe, surse publice.
      </p>
    </div>
    <div>
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--accent);margin-bottom:6px;">Cod sursă</div>
      <p style="font-family:var(--sans);font-size:12px;line-height:1.55;color:#C9C9CB;">
        Proiect personal · pax@mioritics.ro
      </p>
    </div>
  </div>
  <div style="max-width:1600px;margin:14px auto 0;border-top:1px solid #2A2C30;padding-top:10px;font-family:var(--sans);font-size:10.5px;color:var(--muted);">
    Cum ne numim străzile · variantă densă · {{ section1.total_streets | default(0) | int | string }} adrese · ultima actualizare 14.05.2025
  </div>
</footer>

{# JavaScript for Section 2 (județ filter) #}
<script>
(function() {
  const LIMIT = 30;

  const JUDET_NAMES = {
    AB:'Alba', AG:'Argeș', AR:'Arad', B:'București', BC:'Bacău',
    BH:'Bihor', BN:'Bistrița-Năsăud', BR:'Brăila', BT:'Botoșani',
    BV:'Brașov', BZ:'Buzău', CJ:'Cluj', CL:'Călărași',
    CS:'Caraș-Severin', CT:'Constanța', CV:'Covasna', DB:'Dâmbovița',
    DJ:'Dolj', GJ:'Gorj', GL:'Galați', GR:'Giurgiu', HD:'Hunedoara',
    HR:'Harghita', IF:'Ilfov', IL:'Ialomița', IS:'Iași', MH:'Mehedinți',
    MM:'Maramureș', MS:'Mureș', NT:'Neamț', OT:'Olt', PH:'Prahova',
    SB:'Sibiu', SJ:'Sălaj', SM:'Satu Mare', SV:'Suceava', TL:'Tulcea',
    TM:'Timiș', TR:'Teleorman', VL:'Vâlcea', VN:'Vrancea', VS:'Vaslui',
  };

  const CAT_RO = {
    'persoană':'persoană','natură':'natură','religios':'religios','dată':'dată',
    'religious':'religios','ideological':'ideologic','abstract':'abstract',
    'institutional':'instituțional','trade':'meșteșug','occupational':'ocupațional',
    'commemorative':'comemorativ','mythology':'mitologie','infrastructure':'infrastructură',
    'place':'loc','category':'categorie',
  };

  const select = document.getElementById('s2-judet-select');
  const available = Object.keys(DATA_S2.by_judet || {}).sort((a, b) => {
    const na = JUDET_NAMES[a] || a, nb = JUDET_NAMES[b] || b;
    return na.localeCompare(nb, 'ro');
  });
  available.forEach(code => {
    const opt = document.createElement('option');
    opt.value = code;
    opt.textContent = (JUDET_NAMES[code] || code) + ' · ' + code;
    select.appendChild(opt);
  });

  function renderList(rows, scopeLabel) {
    const list = document.getElementById('s2-list');
    list.innerHTML = '';
    const trimmed = rows.slice(0, LIMIT);
    const maxCount = trimmed[0]?.street_count || 1;

    trimmed.forEach((row, i) => {
      const pct = Math.round(row.street_count / maxCount * 100);
      const isPerson = row.category === 'persoană';
      const catLabel = CAT_RO[row.category] || row.category;
      const tag = row.category !== 'altele'
        ? `<span class="tag${isPerson ? ' person' : ''}">${catLabel}</span>` : '';
      const barClass = isPerson ? 'bar accent' : 'bar';
      list.insertAdjacentHTML('beforeend', `
        <div class="rank-row">
          <span class="rank-num">${i + 1}</span>
          <span class="name-cell"><span class="rank-name">${row.name_normalized}</span>${tag}</span>
          <div class="bar-wrap"><div class="${barClass}" style="width:${pct}%"></div></div>
          <span class="rank-count">${row.street_count.toLocaleString('ro-RO')}</span>
        </div>
      `);
    });
    document.getElementById('s2-footer').textContent =
      `Afișare 1–${trimmed.length} din ${rows.length} · ${scopeLabel}`;
  }

  function render(code) {
    if (code === 'all') {
      renderList(DATA_S2.top_names, 'la nivel național');
    } else {
      const label = (JUDET_NAMES[code] || code) + ' (' + code + ')';
      renderList(DATA_S2.by_judet[code] || [], 'județul ' + label);
    }
  }

  select.addEventListener('change', e => render(e.target.value));
  render('all');
})();
</script>

{# JavaScript for Section 3 (gender grid) #}
<script>
(function() {
  const total = DATA_S3.total_m + DATA_S3.total_f;
  const grid = document.getElementById('s3-gap-grid');
  const femaleSquares = Math.max(1, Math.round(DATA_S3.total_f / total * 100));
  for (let i = 0; i < 100; i++) {
    const sq = document.createElement('div');
    sq.style.cssText = `width:11px;height:11px;border-radius:1px;background:${
      i >= (100 - femaleSquares) ? 'var(--accent)' : 'var(--ink)'
    }`;
    grid.appendChild(sq);
  }
})();
</script>

{# JavaScript for Section 6 (D3 choropleth) #}
<script>
(function() {
  const byJudet = {};
  DATA_S6.by_judet.forEach(d => { byJudet[d.judet] = d; });
  const topPerJudet = DATA_S6.top_per_judet || {};
  const rarePerJudet = DATA_S6.rare_per_judet || {};
  const personsPerJudet = DATA_S6.persons_per_judet || {};

  let activeMetric = 'saint_pct';
  const metricLabels = {
    saint_pct: '% străzi cu prefix „Sf."',
    numeric_pct: '% străzi anonime (numere)',
    female_pct: '% străzi cu nume feminin',
  };

  const colorScale = d3.scaleSequential()
    .interpolator(d3.interpolateRgb('#F4EFE6', '#A53A22'));

  function updateMetric(metric) {
    activeMetric = metric;
    document.querySelectorAll('#s6-metric-row .chip').forEach(c =>
      c.classList.toggle('active', c.dataset.metric === metric)
    );
    const values = DATA_S6.by_judet.map(d => d[metric] || 0);
    const maxVal = d3.max(values);
    colorScale.domain([0, maxVal]);
    document.getElementById('s6-scale-max').textContent = maxVal.toFixed(1) + '%';
    document.getElementById('s6-scale-label').textContent = metricLabels[metric];

    d3.selectAll('.judet-path').attr('fill', d => {
      const code = d.properties?.cod;
      const row = byJudet[code];
      return row ? colorScale(row[metric] || 0) : '#EEEAE0';
    });
  }

  document.querySelectorAll('#s6-metric-row .chip').forEach(btn => {
    btn.addEventListener('click', () => updateMetric(btn.dataset.metric));
  });

  fetch('ro-counties.geojson')
    .then(r => r.json())
    .then(geo => {
      const svg = d3.select('#s6-map');
      // The map cell is 8/12 of the panel content area minus the 24px gap.
      // Use the actual rendered width of the SVG's containing cell.
      const cellWidth = svg.node().parentElement.clientWidth;
      const width = cellWidth;
      const height = width * 0.62;
      svg.attr('viewBox', `0 0 ${width} ${height}`);

      const projection = d3.geoMercator().fitSize([width, height], geo);
      const path = d3.geoPath().projection(projection);

      svg.selectAll('.judet-path')
        .data(geo.features)
        .join('path')
        .attr('class', 'judet-path')
        .attr('d', path)
        .attr('stroke', '#FAF8F3')
        .attr('stroke-width', 0.9)
        .style('cursor', 'pointer')
        .on('click', (event, d) => renderFingerprint(d))
        .on('mouseenter', function() { d3.select(this).attr('stroke-width', 1.8).attr('stroke', '#15171A'); })
        .on('mouseleave', function() { d3.select(this).attr('stroke-width', 0.9).attr('stroke', '#FAF8F3'); });

      updateMetric('saint_pct');
    })
    .catch(() => {
      document.getElementById('s6-map').insertAdjacentHTML('afterend',
        '<p style="font-family:var(--sans);font-size:12px;color:var(--muted);padding:14px 0;">Harta indisponibilă — rulați build_site.py pentru a copia ro-counties.geojson în dist/</p>'
      );
    });

  function renderFingerprint(feature) {
    const code = feature.properties?.cod;
    const row = byJudet[code] || {};
    const top = topPerJudet[code] || [];
    const rare = rarePerJudet[code] || [];
    const persons = personsPerJudet[code] || [];

    const scopeDot = s => ({ universal: '🌍', national: '🇷🇴', local: '·' }[s] || '·');
    const genderDot = g => g === 'F' ? '<span style="color:#C05E8A;">●</span>' : '<span style="color:#4A7FA5;">●</span>';

    const topRows = top.map((s, i) =>
      `<div style="display:flex;justify-content:space-between;align-items:center;padding:3px 0;border-bottom:1px solid var(--rule);">
        <span class="street-tag small">${s.n}</span>
        <span style="color:var(--muted);font-size:10.5px;font-variant-numeric:tabular-nums;">${s.c}</span>
      </div>`
    ).join('');

    const personsRows = persons.map((p, i) =>
      `<div style="display:flex;justify-content:space-between;align-items:center;padding:2px 0;border-bottom:1px solid var(--rule);">
        <span style="display:flex;align-items:center;gap:5px;">
          ${genderDot(p.g)}
          <span style="font-family:var(--sans);color:var(--ink);font-weight:${i===0?'600':'500'};font-size:11.5px;">${p.n}</span>
        </span>
        <span style="color:var(--muted);font-size:10.5px;font-variant-numeric:tabular-nums;">${p.c} ${p.s ? scopeDot(p.s) : ''}</span>
      </div>`
    ).join('');

    const rareRows = rare.map(s =>
      `<div style="display:flex;justify-content:space-between;align-items:center;padding:3px 0;border-bottom:1px solid var(--rule);">
        <span class="street-tag small">${s.n}</span>
        <span style="color:var(--muted);font-size:10.5px;">${s.j === 1 ? 'unic' : s.j + ' județe'}</span>
      </div>`
    ).join('');

    const fp = document.getElementById('s6-fingerprint');
    fp.innerHTML = `
      <div class="kicker">Amprenta județului · selectat</div>
      <div style="font-family:var(--sans);font-weight:600;font-size:18px;margin:2px 0 2px;letter-spacing:-.005em;">${feature.properties?.name || code}</div>
      <div style="font-family:var(--sans);font-size:10.5px;color:var(--muted);margin-bottom:12px;font-variant-numeric:tabular-nums;">${(row.total_streets || 0).toLocaleString('ro-RO')} de străzi · Sfinți ${(row.saint_pct || 0).toFixed(1)}% · Feminin ${(row.female_pct || 0).toFixed(1)}%</div>

      <div class="kicker" style="margin-bottom:4px;">Cele mai frecvente</div>
      <div style="margin-bottom:12px;">${topRows || '<span style="color:var(--muted)">—</span>'}</div>

      <div class="kicker" style="margin-bottom:4px;">Persoane omagiate</div>
      <div style="margin-bottom:12px;">${personsRows || '<span style="color:var(--muted)">—</span>'}</div>

      <div class="kicker" style="margin-bottom:4px;">Cele mai rare (unice național)</div>
      <div>${rareRows || '<span style="color:var(--muted)">—</span>'}</div>
    `;
  }
})();
</script>

</body>
</html>
