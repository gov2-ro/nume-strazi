    {% if tok.slug %}
    <a href="/tema/{{ tok.slug }}/" style="font-family:var(--sans);font-size:20px;font-weight:500;padding:7px 14px;border:1.5px solid {{ 'var(--accent)' if tok.n > 30 else 'var(--rule-strong)' }};border-radius:3px;color:{{ 'var(--accent-dark)' if tok.n > 30 else 'var(--ink)' }};background:{{ '#FFF1ED' if tok.n > 30 else 'var(--bg)' }};text-decoration:none;display:inline-flex;align-items:center;">
      {{ ideo_ro.get(tok.token, tok.token) }} <span style="color:var(--muted);font-size:16px;margin-left:6px;font-variant-numeric:tabular-nums;font-weight:500;">{{ tok.n }}</span>
    </a>
    {% else %}
    <span style="font-family:var(--sans);font-size:20px;font-weight:500;padding:7px 14px;border:1.5px solid {{ 'var(--accent)' if tok.n > 30 else 'var(--rule-strong)' }};border-radius:3px;color:{{ 'var(--accent-dark)' if tok.n > 30 else 'var(--ink)' }};background:{{ '#FFF1ED' if tok.n > 30 else 'var(--bg)' }};">
      {{ ideo_ro.get(tok.token, tok.token) }} <span style="color:var(--muted);font-size:16px;margin-left:6px;font-variant-numeric:tabular-nums;font-weight:500;">{{ tok.n }}</span>
    </span>
    {% endif %}
    {% endfor %}
    {% if not section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:20px;font-style:italic;color:var(--muted);">Subcategorii în curs de completare.</span>
    {% endif %}
  </div>
</div>

{# PANEL: ECART DE GEN (s4) #}
<div class="panel s4" id="pe-cine-onoram">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">⚥</span> Ecart de gen</span>
    <span class="panel-meta">{{ section3.total_m + section3.total_f }} pers.</span>
  </div>
  <div style="display:flex;gap:16px;align-items:start;">
    <div>
      <div style="font-family:var(--sans);font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">Fiecare pătrat = 1 persoană</div>
      <div id="s3-gap-grid" style="display:grid;grid-template-columns:repeat(10,11px);gap:2px;width:130px;"></div>
