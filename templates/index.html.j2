{# Stats widget — V3b · responsive 4→2→1 columns #}
{% set total_gendered = section1.total_persons_m + section1.total_persons_f %}
{% set male_pct = (section1.total_persons_m / total_gendered * 100) | round | int if total_gendered else 0 %}
{% set female_pct = 100 - male_pct if total_gendered else 0 %}
{% set total_persons = section3.total_m + section3.total_f %}
{# Tematică: top category as headline, top-4 named, remainder grouped as "altele".
   Colours match the conic-gradient in the Repartiție tematică panel below. #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_palette = ['#C04F35','#A0826A','#8BA888','#6E6E70','#B8A090','#3A3A3D','#DDDCD7'] %}
{% set theme_ro = {
  'natură':'natură','persoană':'persoane','concept / abstract':'abstract',
  'ideologic':'ideologic','dată / sărbătoare':'date','religios':'religios'
} %}
{% set top4 = section5.theme_dist[:4] %}
{% set rest = section5.theme_dist[4:] %}
{% set rest_count = rest | sum(attribute='count') %}
{% set lead = section5.theme_dist[0] %}
{% set lead_pct = (lead.count / theme_total * 100) | round | int %}
<div class="statbar">

  <div class="group">
    <div class="group-label"><span class="emo lg">📊</span> Scară</div>
    <div class="scale-stack">
      <div class="item">
        <div class="v">{{ "{:,.0f}".format(section1.total_streets).replace(",", ".") }}</div>
        <div class="l">Adrese</div>
      </div>
      <div class="item">
        <div class="v">{{ total_persons }}</div>
        <div class="l">Persoane onorate</div>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-label"><span class="emo lg">🏷️</span> Tematică</div>
    <div class="tema-row">
      <div class="v">{{ lead_pct }}<span class="u">% {{ theme_ro[lead.category] | default(lead.category) }}</span></div>
    </div>
    <div class="minibar">
      {% for t in top4 %}
        {% set pct = (t.count / theme_total * 100) %}
        <div style="width:{{ pct }}%;background:{{ theme_palette[loop.index0] }};"></div>
      {% endfor %}
      {% if rest_count %}
        {% set rest_pct = (rest_count / theme_total * 100) %}
        <div style="width:{{ rest_pct }}%;background:{{ theme_palette[4] }};"></div>
      {% endif %}
    </div>
    <div class="l">
      {% for t in top4[1:] %}
        {% set pct = (t.count / theme_total * 100) | round | int %}
        {{ theme_ro[t.category] | default(t.category) }} <strong style="color:var(--ink);">{{ pct }}%</strong>{{ ' · ' if not loop.last }}
      {% endfor %}
    </div>
  </div>

  <div class="group">
    <div class="group-label"><span class="emo lg">⚥</span> Repartiție pe gen</div>
    <div class="gen-row">
      <div class="v">{{ male_pct }}<span class="u">% B</span></div>
      <div class="frac">/ <span class="accent" style="font-weight:600;">{{ female_pct }}% F</span></div>
    </div>
    <div class="minibar">
      <div style="width:{{ male_pct }}%;background:rgba(0,0,0,.42);"></div>
      <div style="width:{{ female_pct }}%;background:var(--accent);"></div>
    </div>
    <div class="l">Persoane onorate, M vs F</div>
  </div>

  <div class="group">
    <div class="group-label"><span class="emo lg">🏆</span> Cei mai des onorați</div>
    <div class="top-pair">
      {% if section1.top_men %}
      <div class="row">
        <span class="prefix">#1 B</span>
        <span class="name">{{ section1.top_men[0].full_name }}</span>
        <span class="cnt">{{ section1.top_men[0].street_count }}<span class="u">str.</span></span>
      </div>
      {% endif %}
      {% if section1.top_women %}
      <div class="row">
        <span class="prefix">#1 F</span>
        <span class="name">{{ section1.top_women[0].full_name }}</span>
        <span class="cnt">{{ section1.top_women[0].street_count }}<span class="u">str.</span></span>
      </div>
      {% endif %}
    </div>
  </div>

</div>

<div class="dash-grid">

{# PANEL: CELE MAI FRECVENTE (s6, cluster cloud) #}
<div class="panel s6 cluster-panel" id="cele-mai-intalnite">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">🔝</span> Cele mai frecvente · Top 50</span>
  </div>
  <div id="s2-clusters">
    {# Populated by JS #}
  </div>
  <div class="panel-meta-tail" id="s2-footer"></div>
</div>

{# PANEL: TOP PERSOANE — moved up, flat cloud, s6 next to streets panel.
   Split into stacked Bărbați / Femei sub-sections so women have their own top. #}
<div class="panel s6 cluster-panel" id="top-persoane">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">👥</span> Top persoane onorate</span>
  </div>
  <div class="sub-section">
    <div class="sub-eyebrow"><span class="dot" style="background:var(--plaque);"></span>Bărbați<span class="meta" id="s3p-men-count"></span></div>
    <div id="s3p-men">{# Populated by JS #}</div>
  </div>
  <div class="sub-section">
    <div class="sub-eyebrow"><span class="dot" style="background:var(--accent);"></span>Femei<span class="meta" id="s3p-women-count"></span></div>
    <div id="s3p-women">{# Populated by JS #}</div>
  </div>
  <div class="sub-section">
    <div class="sub-eyebrow"><span class="dot" style="background:#6B8E23;"></span>Non-române<span class="meta" id="s3p-foreigners-count"></span></div>
    <div id="s3p-foreigners">{# Populated by JS #}</div>
  </div>
</div>

{# PANEL: REPARTIȚIE TEMATICĂ (s4) #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_colors = ['#5F7A4E','#0E4D92','#5A6573','#C04F35','#E8AE00','#7A4A33','#B0B7C0'] %}
{% set theme_emoji = {
  'natură':'🌿','persoană':'👤','concept / abstract':'💭',
  'ideologic':'🚩','dată / sărbătoare':'📅','religios':'⛪'
} %}
{% set ns = namespace(cumulative=0) %}
<div class="panel s4" id="tematica">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">🧭</span> Repartiție tematică</span>
    <span class="panel-meta">{{ "{:,.0f}".format(theme_total).replace(",", ".") }} clasif.</span>
  </div>
  <div style="display:flex;gap:18px;align-items:center;">
    <div style="position:relative;width:96px;height:96px;flex-shrink:0;">
      <div id="s5-donut" style="width:96px;height:96px;border-radius:50%;background:conic-gradient(
        {% for t in section5.theme_dist %}
        {% set pct = (t.count / theme_total * 100) | round(1) %}
        {{ theme_colors[loop.index0 % theme_colors|length] }} {{ ns.cumulative }}% {{ ns.cumulative + pct }}%{{ ',' if not loop.last }}
        {% set ns.cumulative = ns.cumulative + pct %}
        {% endfor %}
      );"></div>
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;background:var(--bg);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">
        <div class="display-num" id="s5-donut-total" style="font-size:15px;">{{ "{:,.0f}".format(theme_total).replace(",", ".") }}</div>
        <div style="font-family:var(--sans);font-size:8.5px;color:var(--muted);letter-spacing:.06em;">total</div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:5px;flex:1;min-width:0;">
      {% for t in section5.theme_dist %}
      {% set pct = (t.count / theme_total * 100) | round(1) %}
      <div data-cat="{{ t.category }}" style="display:flex;align-items:center;gap:8px;">
        <div style="width:10px;height:10px;border-radius:2px;background:{{ theme_colors[loop.index0 % theme_colors|length] }};flex-shrink:0;"></div>
        <span class="emo xxl">{{ theme_emoji.get(t.category, '·') }}</span>
        {% if t.slug %}
        <a href="/tema/{{ t.slug }}/" style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink);text-decoration:none;">{{ t.category }}</a>
        {% else %}
        <span style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ t.category }}</span>
        {% endif %}
        <span class="s5-pct" style="font-family:var(--sans);font-size:24px;font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:-.01em;">{{ pct }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# PANEL: SUBTIPURI NATURĂ (s4) #}
{% set nature_ro = {
  'flower':'flori','tree':'copaci','water':'apă','plant':'plante',
  'bird':'păsări','sky':'cer','geography':'geografie','forest':'pădure',
  'meadow':'câmpie','season':'anotimpuri','animal':'animale',
  'weather':'vreme','fruit':'fructe','field':'câmp','hill':'deal',
  'orchard':'livadă','valley':'vale','peak':'vârf','mountain':'munte',
  'mountain_peak':'vârf de munte'
} %}
{% set nature_emoji = {
  'flower':'🌸','tree':'🌳','water':'💧','plant':'🌱','bird':'🐦',
  'sky':'☁️','geography':'🗺️','forest':'🌲','meadow':'🌾','season':'🍂',
  'animal':'🦌','weather':'🌦️','fruit':'🍎','field':'🌾','hill':'⛰️',
  'orchard':'🍒','valley':'🏞️','peak':'🏔️','mountain':'⛰️','mountain_peak':'🏔️'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">🌿</span> Subtipuri · Natură</span>
  </div>
  <div id="s5-nature-list">
  {% set max_n = section5.nature_subtypes[0].n if section5.nature_subtypes else 1 %}
  {% for row in section5.nature_subtypes %}
  <div style="display:flex;align-items:center;gap:8px;padding:3px 0;{% if not loop.first %}border-top:1px solid var(--hairline);{% endif %}">
    <span class="emo xxl" style="width:24px;text-align:center;">{{ nature_emoji.get(row.nature_type, '·') }}</span>
    {% if row.slug %}
    <a href="/tema/{{ row.slug }}/" style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink);text-decoration:none;">{{ nature_ro.get(row.nature_type, row.nature_type) }}</a>
    {% else %}
    <span style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ nature_ro.get(row.nature_type, row.nature_type) }}</span>
    {% endif %}
    <div class="bar-wrap" style="width:90px;"><div class="bar olive" style="width:{{ (row.n / max_n * 100)|int }}%;"></div></div>
    <span style="font-family:var(--sans);font-size:22px;font-weight:500;color:var(--ink);width:56px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-.005em;">{{ row.n }}</span>
  </div>
  {% endfor %}
  </div>
</div>

{# PANEL: TOKENI IDEOLOGICI (s4) #}
{% set ideo_ro = {
  'victory':'victorie','national_day':'zi națională','brotherhood':'frăție',
  'youth':'tinerețe','workers':'muncitori','unification':'unire',
  'triumph':'triumf','solidarity':'solidaritate','revolution':'revoluție',
  'republic':'republică','rebirth':'renaștere','progress':'progres',
  'peace':'pace','liberation':'eliberare','labor':'muncă',
  'independence':'independență','homeland':'patrie','glory':'glorie',
  'freedom':'libertate','fraternity':'frăternitate','equality':'egalitate',
  'emancipation':'emancipare','democracy':'democrație','cooperative':'cooperativă',
  'communist_press':'presă comunistă','commemorative':'comemorativ'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">🚩</span> Tokeni ideologici</span>
  </div>
