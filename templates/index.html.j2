      <div class="display-num" style="font-size:44px;margin-bottom:4px;">{{ section4.tier_counts.local }}</div>
      <div style="font-family:var(--sans);font-size:13px;color:var(--muted);font-weight:500;">sub 5 limbi</div>
    </div>
  </div>
</div>

{# PANEL: RENUMIRI placeholder (s6) #}
<div class="panel s6" id="renumiri" style="display:none;">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">📝</span> Renumiri</span>
