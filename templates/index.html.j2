{# PANEL: EPOCI (s4) #}
{% set era_ro = {
  'ancient':'antichitate','medieval':'medieval','premodern':'premodern (1700–1900)',
  '1848':'generația de la 1848','interwar':'interbelic (1900–1947)',
  'communist':'comunism (1947–1989)'
} %}
{% set era_emoji = {
  'ancient':'🏺','medieval':'🏰','premodern':'🕯️',
  '1848':'🗽','interwar':'🎩','communist':'⭐'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">⏳</span> Epoca în care a trăit</span>
  </div>
  <div id="s3-era-list">
  {% set max_era = section3.era_dist[0].n if section3.era_dist else 1 %}
  {% for row in section3.era_dist %}
  <div style="display:flex;align-items:center;gap:8px;padding:3px 0;{% if not loop.first %}border-top:1px solid var(--hairline);{% endif %}">
    <span class="emo xxl" style="width:24px;text-align:center;">{{ era_emoji.get(row.era, '·') }}</span>
    <span style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ era_ro.get(row.era, row.era or 'necunoscută') }}</span>
    <div class="bar-wrap" style="width:90px;">
      <div class="bar" style="width:{{ (row.n / max_era * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:22px;font-weight:500;color:var(--ink);width:48px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-.005em;">{{ row.n }}</span>
  </div>
  {% endfor %}
  </div>
</div>

{# (Top persoane panel removed — moved up to sit beside #cele-mai-intalnite as an s6 cluster cloud.) #}

{# PANEL: PERSONALITĂȚI STRĂINE (s8) #}
{% if section3.top_foreigners %}
{% set nat_flag = {
  'HU':'🇭🇺','FR':'🇫🇷','DE':'🇩🇪','IT':'🇮🇹','GB':'🇬🇧',
  'RU':'🇷🇺','AT':'🇦🇹','PL':'🇵🇱','TR':'🇹🇷','US':'🇺🇸',
  'GR':'🇬🇷','SR':'🇷🇸','UA':'🇺🇦','CZ':'🇨🇿','SK':'🇸🇰',
  'BG':'🇧🇬','MD':'🇲🇩','HR':'🇭🇷','SI':'🇸🇮','CH':'🇨🇭',
  'ES':'🇪🇸','PT':'🇵🇹','NL':'🇳🇱','BE':'🇧🇪','SE':'🇸🇪',
  'NO':'🇳🇴','DK':'🇩🇰','FI':'🇫🇮','IL':'🇮🇱','JP':'🇯🇵',
} %}
{% set prof_ro = {
  'poet':'poet','writer':'scriitor','composer':'compozitor',
  'royalty':'rege / voievod','politician':'politician',
  'military':'militar','revolutionary':'revoluționar',
  'scientist':'om de știință','painter':'pictor','philosopher':'filozof',
} %}
<div id="s3-foreigners-panel" class="panel s8">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">🌍</span> Personalități non-române honorate pe străzi</span>
    <span class="panel-meta" id="s3-foreigners-count">{{ section3.top_foreigners | length }} persoane</span>
  </div>
  {% set max_f = section3.top_foreigners[0].street_count if section3.top_foreigners else 1 %}
  <div id="s3-foreigners-list" class="rank-list">
    {% for p in section3.top_foreigners %}
    <div class="rank-row" style="grid-template-columns:32px minmax(0,1fr) minmax(50px,0.9fr) 48px 80px;">
      <span style="font-size:20px;line-height:1;text-align:center;">{{ nat_flag.get(p.nationality, '🏳️') }}</span>
      <span class="rank-name person" style="display:flex;align-items:center;gap:7px;">
        {% if p.wikidata_qid and p.wikidata_qid in portraits %}
        <span class="portrait" style="width:22px;height:22px;border-radius:50%;overflow:hidden;flex-shrink:0;display:inline-flex;">
          <img src="/portraits/{{ p.wikidata_qid }}.jpg" alt="" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
        </span>
        {% endif %}
        {% if p.slug %}<a href="/persoana/{{ p.slug }}/" style="color:inherit;text-decoration:none;">{{ p.full_name }}</a>{% else %}{{ p.full_name }}{% endif %}
      </span>
      <span style="font-family:var(--sans);font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ prof_ro.get(p.profession, p.profession or '—') }}</span>
      <div class="bar-wrap">
        <div class="bar" style="width:{{ (p.street_count / max_f * 100)|int }}%"></div>
      </div>
      <span class="rank-count">{{ p.street_count }}</span>
    </div>
    {% endfor %}
  </div>
  <div class="panel-caption" style="margin-top:10px;">Concentrate predominant în județele cu comunități maghiare istorice (Harghita, Covasna, Mureș, Bihor).</div>
</div>
{% endif %}

{# PANEL: NOTORIETATE WIKIPEDIA (s12, 2-col internal) #}
<div class="panel s12">
  <div class="panel-header">
    <span class="panel-label"><span class="emo xl">📈</span> Notorietate Wikipedia · vizualizări lunare medii · ro.wikipedia.org · 12 luni</span>
  </div>
  <div id="s4-pv-list" class="rank-list rank-2col s4-list">
    {% set max_pv = section4.top_pageviews[0].wiki_ro_views if section4.top_pageviews else 1 %}
    {% for p in section4.top_pageviews %}
    <div class="rank-row">
      {% if p.slug %}<a href="/persoana/{{ p.slug }}/" style="color:inherit;text-decoration:none;"><span class="rank-name person">{{ p.full_name }}</span></a>
      {% else %}<span class="rank-name person">{{ p.full_name }}</span>{% endif %}
      <div class="bar-wrap">
        <div class="{{ 'bar accent' if p.wiki_scope == 'universal' else 'bar' }}"
             style="width:{{ (p.wiki_ro_views / max_pv * 100)|int }}%"></div>
      </div>
      <span class="rank-count">{{ "{:,.0f}".format(p.wiki_ro_views).replace(",", ".") }}</span>
      <span class="tag{{ ' person' if p.wiki_scope == 'universal' else '' }}">{{ p.wiki_scope or '—' }}</span>
    </div>
    {% endfor %}
  </div>
</div>

