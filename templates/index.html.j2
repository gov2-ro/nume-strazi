{# templates/index.html.j2 — primary dashboard: cluster-cloud top + side-by-side persoane #}
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cum ne numim străzile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&family=Barlow+Semi+Condensed:wght@600;700&display=swap" rel="stylesheet">
  <script>
const DATA_S2 = {{ section2 | tojson }};
const DATA_S3 = {{ section3 | tojson }};
const DATA_S4 = {{ section4 | tojson }};
const DATA_S5 = {{ section5 | tojson }};
const DATA_MUNICIPII = {{ municipii | tojson }};
const PORTRAITS = new Set({{ portraits | tojson }});
  </script>
  <style>
:root {
  /* Surfaces */
  --bg: #FFFFFF;
  --surface-1: #F7F9FC;
  --surface-2: #ECF1F8;
  --surface-blue: #DEE8F4;
  --warn-1: #FFF7CC;
  --warn-2: #FBE486;
  --ink-band: #0B1118;

  /* Ink + rules */
  --ink: #0B1118;
  --ink-2: #2A313B;
  --muted: #5A6573;
  --muted-2: #8B95A2;
  --rule: #E2E6EC;
  --rule-strong: #BFC7D2;
  --hairline: #EEF1F5;

  /* Accents */
  --plaque: #0E4D92;
  --plaque-deep: #08366D;
  --accent: #C04F35;
  --accent-dark: #8E3320;
  --gold: #E8AE00;
  --gold-soft: #F7D777;
  --olive: #5F7A4E;
  --teal: #2F6B6B;

  /* Fonts */
  --sans: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
  --mono: 'IBM Plex Mono', monospace;
  --street: 'Barlow Semi Condensed', 'IBM Plex Sans', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 13px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-variant-ligatures: common-ligatures contextual;
}

/* ──────── ICONS ──────── */
.icon { width: 14px; height: 14px; flex-shrink: 0; vertical-align: middle; stroke: currentColor; stroke-width: 1.75; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.icon.sm { width: 11px; height: 11px; stroke-width: 1.9; }
.icon.lg { width: 18px; height: 18px; }
.icon.xl { width: 22px; height: 22px; stroke-width: 1.6; }

/* Portrait — circular person thumbnail */
.portrait {
  width: 26px; height: 26px;
  border-radius: 999px;
  background: var(--surface-2) linear-gradient(135deg, var(--surface-2), var(--surface-blue));
  border: 1px solid var(--rule-strong);
  flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--muted-2);
  font-family: var(--sans); font-size: 10px; font-weight: 700;
  letter-spacing: .02em;
  overflow: hidden;
  vertical-align: middle;
}
.portrait.lg { width: 36px; height: 36px; font-size: 12px; }
.portrait img { width: 100%; height: 100%; object-fit: cover; }

/* Person chip and street plaque tokens: portrait overflows the sign border */
.ctok.person,
.ctok.street {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
}
.ctok.person .portrait,
.ctok.street .portrait {
  width: 46px; height: 46px;
  font-size: 14px;
  margin-right: -18px;
  z-index: 2;
  position: relative;
  box-shadow: 0 0 0 3px var(--bg);
}
.ctok.person.has-portrait .chip {
  padding-left: 24px;
}
.ctok.street.has-portrait .plaque {
  padding-left: 24px;
}

/* Emoji helper: keep size aligned with surrounding body text */
.emo {
  font-family: 'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji', sans-serif;
  font-style: normal; font-weight: 400;
  display: inline-block;
  line-height: 1;
  font-variant-emoji: emoji;
}
.emo.sm  { font-size: 10px; }
.emo.md  { font-size: 12px; }
.emo.lg  { font-size: 14px; }
.emo.xl  { font-size: 18px; }
.emo.xxl { font-size: 22px; }

/* Nav */
.site-nav {
  position: sticky; top: 0; z-index: 100;
  background: var(--bg);
  border-bottom: 1px solid var(--ink);
  padding: 10px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--sans);
  font-size: 11.5px;
  letter-spacing: .06em;
}
.site-nav .brand {
  font-weight: 700;
  color: var(--ink);
  letter-spacing: .14em;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 12.5px;
  display: inline-flex; align-items: center; gap: 8px;
}
.site-nav .brand::before {
  content: '◆';
  color: var(--gold);
  font-size: 10px;
  line-height: 1;
}
.site-nav nav { display: flex; gap: 22px; }
.site-nav nav a {
  color: var(--muted); text-decoration: none;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .1em;
  font-size: 10.5px;
  padding-bottom: 2px;
  border-bottom: 2px solid transparent;
  transition: color .12s ease, border-color .12s ease;
}
.site-nav nav a:hover { color: var(--ink); border-bottom-color: var(--gold); }
.site-nav .nav-sep {
  display: inline-block; width: 1px; height: 16px;
  background: var(--rule); margin: 0 4px; align-self: center;
}
.site-nav select {
  background: transparent;
  border: 1px solid var(--rule);
  color: var(--ink);
  font-family: var(--sans); font-size: 11px; font-weight: 600;
  padding: 2px 22px 2px 8px;
  border-radius: 3px; height: 26px; cursor: pointer;
  -webkit-appearance: none; -moz-appearance: none; appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--muted) 50%),
    linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position: calc(100% - 9px) 54%, calc(100% - 5px) 54%;
  background-size: 4px 4px, 4px 4px; background-repeat: no-repeat;
  max-width: 170px;
}
.site-nav select:focus { outline: none; border-color: var(--gold); }
#s2-uat-select { display: none; }

/* Stats widget — dark ink band with reverse-out type. Acts as the
   dashboard's masthead "ticker": dense, high-contrast, Bloomberg-feel.
   4-col on desktop → 2-col at ≤1024 → 1-col at ≤640. */
.statbar {
  background: var(--surface-1);
  color: var(--ink);
  border-bottom: 3px solid var(--gold);
  padding: 22px 28px 24px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.45fr;
  gap: 0;
  align-items: stretch;
  position: relative;
}
.statbar::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0;
  height: 1px; background: var(--hairline);
}
.statbar .group {
  display: flex; flex-direction: column; gap: 10px;
  padding: 0 26px 0 0;
  min-width: 0;
  border-right: 1px solid var(--rule);
}
.statbar .group + .group { padding-left: 26px; }
.statbar .group:last-child { border-right: none; padding-right: 0; }

.statbar .group-label {
  font-family: var(--sans);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .22em;
  color: var(--muted);
  font-weight: 700;
  display: inline-flex; align-items: center; gap: 7px;
}
.statbar .v {
  font-family: var(--sans);
  font-weight: 700;
  font-size: 34px;
  color: var(--ink);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.025em;
}
.statbar .v .u {
  font-size: 14px;
  color: var(--muted);
  margin-left: 4px;
  font-weight: 600;
  letter-spacing: 0;
}
.statbar .l {
  font-family: var(--sans);
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: .14em;
  color: var(--muted);
  margin-top: 4px;
  font-weight: 500;
}
.statbar .accent { color: var(--accent); }

.statbar .scale-stack { display: flex; flex-direction: column; gap: 12px; }
.statbar .scale-stack .item { display: flex; align-items: baseline; gap: 12px; }
.statbar .scale-stack .item .v { font-size: 28px; }
.statbar .scale-stack .item .l { margin-top: 0; }

.statbar .tema-row, .statbar .gen-row { display: flex; align-items: baseline; gap: 8px; }
.statbar .gen-row .frac {
  font-family: var(--sans);
  font-size: 15px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.statbar .minibar {
  display: flex; height: 8px; border-radius: 0; overflow: hidden;
  background: var(--rule); margin-top: 4px;
}

.statbar .top-pair { display: flex; flex-direction: column; gap: 9px; }
.statbar .top-pair .row {
  display: flex; align-items: baseline; gap: 10px;
  font-family: var(--sans);
}
.statbar .top-pair .prefix {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .18em;
  color: var(--muted);
  font-weight: 700;
  min-width: 28px;
}
.statbar .top-pair .name {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -.005em;
}
.statbar .top-pair .cnt {
  font-family: var(--sans);
  font-weight: 700;
  font-size: 15px;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  margin-left: auto;
  letter-spacing: -.01em;
}
.statbar .top-pair .cnt .u {
  font-size: 10.5px;
  color: var(--muted);
  margin-left: 3px;
  font-weight: 600;
}

@media (max-width: 1024px) {
  .statbar {
    grid-template-columns: 1fr 1fr;
    row-gap: 24px;
    padding: 20px 22px 22px;
  }
  .statbar .group:nth-child(2) { border-right: none; padding-right: 0; }
  .statbar .group:nth-child(3) { padding-left: 0; }
}
@media (max-width: 640px) {
  .statbar {
    grid-template-columns: 1fr;
    row-gap: 22px;
    padding: 18px 18px 20px;
  }
  .statbar .group {
    border-right: none !important;
    padding: 0 0 18px 0 !important;
    border-bottom: 1px solid var(--rule);
  }
  .statbar .group:last-child {
    border-bottom: none;
    padding-bottom: 0 !important;
  }
}

/* 12-col panel grid — hairline 1px grid lines between panels */
.dash-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 1px;
  background: var(--rule-strong);
  max-width: 1640px;
  margin: 0 auto;
  border-bottom: 1px solid var(--rule-strong);
}
.panel {
  background: var(--bg);
  padding: 14px 16px 12px;
  grid-column: span 6;
  min-width: 0;
}
.panel.s4  { grid-column: span 4; }
.panel.s6  { grid-column: span 6; }
.panel.s8  { grid-column: span 8; }
.panel.s12 { grid-column: span 12; }

/* Panel header — heavy 2px rule below, ink-black label, gold-on-hover lift */
.panel-header {
  display: flex; justify-content: space-between; align-items: center;
  margin: 0 0 12px;
  padding: 0 0 8px;
  border-bottom: 2px solid var(--ink);
  gap: 12px; flex-wrap: wrap;
  position: relative;
}
.panel-label {
  font-family: var(--sans);
  font-size: 11.5px;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--ink);
  display: inline-flex; align-items: center; gap: 7px;
}
.panel-meta {
  font-family: var(--sans);
  font-size: 11px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
  letter-spacing: .04em;
}

.panel-caption {
  font-family: var(--sans);
  font-size: 12px;
  color: var(--muted);
  margin-top: 8px;
  line-height: 1.5;
}

.kicker {
  font-family: var(--sans);
  font-size: 10px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--ink);
  font-weight: 700;
  margin-bottom: 8px;
  display: inline-flex; align-items: center; gap: 6px;
}
.kicker.muted { color: var(--muted); font-weight: 600; }

/* Chip toggles — sharp squared pills */
.chip-row {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  margin-bottom: 10px; padding-bottom: 8px;
  border-bottom: 1px solid var(--rule);
  font-family: var(--sans); font-size: 11.5px;
}
.chip-row .label {
  letter-spacing: .14em; text-transform: uppercase;
  font-weight: 700; color: var(--muted);
  font-size: 10.5px; margin-right: 4px;
}
.chip {
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 600;
  color: var(--ink);
  padding: 4.5px 11px;
  border: 1px solid var(--rule-strong);
  border-radius: 2px;
  background: var(--bg);
  cursor: pointer;
  letter-spacing: .02em;
  transition: background .12s ease, color .12s ease, border-color .12s ease;
}
.chip:hover { background: var(--surface-2); border-color: var(--ink); }
.chip.active {
  color: #FFFFFF;
  background: var(--ink);
  border-color: var(--ink);
}

/* Județ picker — hard outline, bold weight */

/* Tag pills — square, denser, bolder */
.tag {
  font-family: var(--sans);
  font-size: 10px;
  color: var(--ink-2);
  background: var(--surface-2);
  padding: 2px 7px;
  border-radius: 2px;
  margin-left: 6px;
  vertical-align: middle;
  letter-spacing: .04em;
  font-weight: 600;
  text-transform: lowercase;
}
.tag.person { background: #F8DAD0; color: var(--accent-dark); }
.tag.ideo   { background: #FFF1C6; color: #7A5400; }
.tag.nature { background: #E1ECDA; color: #3D5A2A; }

/* Rank list — generic. Hairline rows + a faint yellow flag on rank #1
   (a gold-leader cue used across all leaderboards). */
.rank-list { display: flex; flex-direction: column; }
.rank-row {
  display: grid;
  align-items: center;
  gap: 10px;
  padding: 5px 4px;
  border-bottom: 1px solid var(--hairline);
  break-inside: avoid;
  transition: background .1s ease;
  position: relative;
}
.rank-row:hover { background: var(--surface-1); }
.rank-row:last-child { border-bottom: none; }

/* Gold inset on the leader row of every list */
.rank-list > .rank-row:first-child {
  background: linear-gradient(to right, var(--warn-1) 0%, rgba(255,247,204,.35) 60%, transparent 100%);
  box-shadow: inset 3px 0 0 var(--gold);
  padding-left: 7px;
}

.rank-num {
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 600;
  color: var(--muted);
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.rank-list > .rank-row:first-child .rank-num {
  color: var(--ink); font-weight: 700;
}

/* Street names rendered as RO street-sign plaques (white-on-blue).
   Slightly upsized for the denser layout. */
.rank-name, .street-tag {
  font-family: var(--street);
  font-weight: 700;
  font-size: 13.5px;
  letter-spacing: .045em;
  display: inline-block;
  padding: 2.5px 10px;
  background: var(--plaque);
  color: #FFFFFF;
  border: none;
  border-radius: 2px;
  text-shadow:
    0 -0.5px 0 rgba(0, 0, 0, .30),
    0 1px 1.5px rgba(0, 0, 0, .50);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .14),
    0 2px 3px rgba(0, 0, 0, .26);
  line-height: 1.25;
  vertical-align: middle;
  width: max-content;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  justify-self: start;
}
.street-tag.small {
  font-size: 12px;
  padding: 1.5px 8px;
}
/* Person names: clean, bold sans, no plaque */
.rank-name.person {
  display: inline;
  padding: 0; border: none; background: transparent; border-radius: 0;
  font-family: var(--sans);
  font-weight: 600;
  font-size: 13px;
  letter-spacing: -.005em;
  color: var(--ink);
  text-shadow: none;
  box-shadow: none;
  max-width: none; overflow: visible;
  width: auto;
  justify-self: auto;
}
.rank-count {
  font-family: var(--sans);
  font-size: 12.5px;
  font-weight: 700;
  color: var(--ink);
  text-align: right;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.005em;
}

/* 2-column rank list (column-count multicol) */
.rank-2col {
  display: block;
  column-count: 2;
  column-gap: 36px;
  column-rule: 1px solid var(--rule);
}
.rank-2col .rank-row { break-inside: avoid; }

/* Per-section row templates */
.s2-list .rank-row     { grid-template-columns: 26px minmax(0, 1fr) 110px 52px; gap: 10px; }
.s3-tower .rank-row    { grid-template-columns: minmax(0, 1fr) minmax(60px, 1fr) 40px; }
.s4-list .rank-row     { grid-template-columns: minmax(0, 1fr) minmax(60px, 1fr) 60px 60px; }

/* Row cell containing the plaque + optional tag */
.name-cell {
  display: flex; align-items: center; gap: 6px;
  min-width: 0;
  overflow: hidden;
}
.name-cell .rank-name { flex: 0 1 auto; min-width: 0; }
.name-cell .tag { flex: 0 0 auto; }

/* Contest row */
.contest-row {
  display: grid;
  grid-template-columns: 14px 140px minmax(50px, 1fr) 36px;
  gap: 8px;
  align-items: center;
  padding: 4px 0;
}
.contest-row + .contest-row { border-top: 1px solid var(--hairline); }
.contest-row .rank-num-mini {
  font-family: var(--sans);
  font-size: 10px;
  font-weight: 600;
  color: var(--muted);
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.contest-row:first-child .rank-num-mini { color: var(--ink); font-weight: 700; }
.contest-row .rank-count-mini {
  font-family: var(--sans);
  font-size: 11.5px;
  font-weight: 700;
  color: var(--ink);
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* Internal 3-col grids inside wide panels */
.subgrid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1px;
  background: var(--rule);
  border: 1px solid var(--rule);
}

/* Bars — taller, more opaque for visual punch */
.bar-wrap {
  height: 5px;
  background: var(--surface-2);
  border-radius: 0;
  position: relative;
}
.bar {
  position: absolute; left: 0; top: 0;
  height: 100%;
  border-radius: 0;
  background: var(--ink);
  opacity: .82;
}
.bar.accent { background: var(--accent); opacity: 1; }
.bar.female { background: var(--accent); opacity: .72; }
.bar.gold   { background: var(--gold);   opacity: .95; }
.bar.olive  { background: var(--olive);  opacity: .9;  }

/* Display numbers */
.display-num {
  font-family: var(--sans);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.025em;
  line-height: 1;
}

/* Map + right-rail fingerprint */
.map-grid {
  display: grid;
  grid-template-columns: 8fr 4fr;
  gap: 28px;
}
.map-grid .fingerprint {
  border-left: 1px solid var(--rule);
  padding-left: 22px;
}

/* Tablet: collapse aggressive 3-up to 2-up, stack map, soften subgrids */
@media (max-width: 1024px) {
  .panel.s4, .panel.s6, .panel.s8 { grid-column: span 6; }
  .panel.s12 { grid-column: span 12; }
  .map-grid { grid-template-columns: 1fr; }
  .map-grid .fingerprint {
    border-left: none;
    border-top: 1px solid var(--rule);
    padding-left: 0;
    padding-top: 16px;
    margin-top: 4px;
  }
  .subgrid-3 { grid-template-columns: 1fr 1fr; }
}

/* Mobile: single column, single-col rank lists, fully collapsed subgrids */
@media (max-width: 640px) {
  .panel { grid-column: span 12 !important; padding: 12px 14px 10px; }
  .dash-grid { gap: 0; max-width: 100%; }
  .rank-2col { column-count: 1; column-rule: none; }
  .site-nav nav { display: none; }
  .subgrid-3 { grid-template-columns: 1fr; }
}

/* ──────── Footer (dark band, mirrors statbar) ──────── */
footer.site-footer { background: var(--ink-band); color: #FFFFFF; padding: 22px 28px; }

/* ──────── Cluster cloud (new top-row panels) ────────
   Replaces the s12 leaderboards for #cele-mai-intalnite and
   "Top persoane onorate". Words flow inline as small tokens grouped
   under category eyebrows. Size variance is intentionally mild.        */
.cluster-panel .panel-header { margin-bottom: 6px; }
.cluster-band {
  padding: 12px 0 14px;
  border-top: 1px solid var(--hairline);
}
.cluster-band:first-of-type { border-top: 0; padding-top: 6px; }
.cluster-band.tail { opacity: .82; }
.cluster-band.highlighted {
  padding-left: 11px;
  border-left: 2px solid var(--cluster-color, var(--ink));
  margin-left: -13px;
}
.cluster-eyebrow {
  display: flex; align-items: baseline; gap: 8px;
  font-family: var(--sans);
  font-size: 10.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .18em;
  color: var(--ink);
  margin-bottom: 9px;
}
.cluster-eyebrow .dot {
  width: 7px; height: 7px; border-radius: 999px;
  background: var(--cluster-color, var(--ink));
  display: inline-block;
}
.cluster-eyebrow .lbl-meta {
  color: var(--muted-2);
  font-weight: 600; letter-spacing: .12em;
  font-family: var(--mono); font-size: 10px;
  margin-left: auto;
}
.cluster-band.tail .cluster-eyebrow { color: var(--muted); }

.flat-tokens {
  display: flex; flex-wrap: wrap;
  align-items: baseline;
  gap: 11px 12px;
  line-height: 1.55;
  padding: 6px 0 4px;
}
.cluster-tokens {
  display: flex; flex-wrap: wrap;
  align-items: baseline;
  gap: 11px 12px;
  line-height: 1.55;
}
.flat-tokens .ctok,
.cluster-tokens .ctok {
  display: inline-block;
  position: relative;
  white-space: nowrap;
}
/* Street plaque token (left panel) */
.ctok.street .plaque {
  display: inline-block;
  background: var(--plaque);
  color: #FFFFFF;
  font-family: var(--street);
  font-weight: 600;
  letter-spacing: .01em;
  padding: 4px 11px;
  border-radius: 3px;
  text-shadow: 0 -0.5px 0 rgba(0,0,0,.30), 0 1px 1.5px rgba(0,0,0,.50);
}
/* Person chip token (right panel) */
.ctok.person .chip {
  display: inline-block;
  background: var(--surface-1);
  color: var(--ink);
  font-family: var(--sans);
  font-weight: 600;
  letter-spacing: .005em;
  padding: 4px 12px;
  border: 1px solid var(--rule-strong);
  border-radius: 4px;
}
.sub-section + .sub-section { margin-top: 14px; }
.sub-eyebrow {
  display: flex; align-items: baseline; gap: 8px;
  font-family: var(--sans);
  font-size: 10.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .18em;
  color: var(--ink);
  margin-bottom: 8px;
}
.sub-eyebrow .dot {
  width: 7px; height: 7px; border-radius: 999px;
  display: inline-block;
}
.sub-eyebrow .meta {
  color: var(--muted-2);
  font-weight: 600; letter-spacing: .12em;
  font-family: var(--mono); font-size: 10px;
  margin-left: auto;
}
.ctok .cnt-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  background: var(--ink-band);
  color: var(--gold-soft);
  padding: 1px 5px;
  border-radius: 7px;
  letter-spacing: .02em;
  line-height: 1.4;
  vertical-align: baseline;
  pointer-events: none;
}
.ctok.person .cnt-badge {
  background: var(--ink-2);
  color: #FFFFFF;
}
.ctok.leader .plaque,
.ctok.leader .chip {
  box-shadow: 0 0 0 2px var(--gold);
}

.cluster-panel .panel-meta-tail {
  font-family: var(--sans); font-size: 10.5px;
  color: var(--muted); padding: 10px 0 0;
}
  </style>
</head>
