{# JavaScript: flat cloud render — both panels share the județ filter #}
<script>
(function() {
  const LIMIT_STREETS = 50;
  const OVERALL_LEADERS = 3;
  const FONT_MIN = 17, FONT_MAX = 28;

  function fontFor(count, lo, hi) {
    if (hi === lo) return (FONT_MIN + FONT_MAX) / 2;
    return FONT_MIN + ((count - lo) / (hi - lo)) * (FONT_MAX - FONT_MIN);
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c =>
      ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  const JUDET_NAMES = {
    AB:'Alba', AG:'Argeș', AR:'Arad', B:'București', BC:'Bacău',
    BH:'Bihor', BN:'Bistrița-Năsăud', BR:'Brăila', BT:'Botoșani',
    BV:'Brașov', BZ:'Buzău', CJ:'Cluj', CL:'Călărași',
    CS:'Caraș-Severin', CT:'Constanța', CV:'Covasna', DB:'Dâmbovița',
    DJ:'Dolj', GJ:'Gorj', GL:'Galați', GR:'Giurgiu', HD:'Hunedoara',
    HR:'Harghita', IF:'Ilfov', IL:'Ialomița', IS:'Iași', MH:'Mehedinți',
    MM:'Maramureș', MS:'Mureș', NT:'Neamț', OT:'Olt', PH:'Prahova',
    SB:'Sibiu', SJ:'Sălaj', SM:'Satu Mare', SV:'Suceava', TL:'Tulcea',
    TM:'Timiș', TR:'Teleorman', VL:'Vâlcea', VN:'Vrancea', VS:'Vaslui',
  };

  const select    = document.getElementById('s2-judet-select');
  const uatSelect = document.getElementById('s2-uat-select');

  // Populate județ options
  Object.keys(DATA_S2.by_judet || {}).sort((a, b) =>
    (JUDET_NAMES[a] || a).localeCompare(JUDET_NAMES[b] || b, 'ro')
  ).forEach(code => {
    const opt = document.createElement('option');
    opt.value = code;
    opt.textContent = (JUDET_NAMES[code] || code) + ' · ' + code;
    select.appendChild(opt);
  });

  // Show/populate/hide the municipiu select when județ changes
  function syncUatSelect(code) {
    uatSelect.innerHTML = '<option value="all">Toate municipiile</option>';
    if (code === 'all') {
      uatSelect.style.display = 'none';
      uatSelect.value = 'all';
      return;
    }
    const municipii = (DATA_MUNICIPII.by_judet || {})[code] || [];
    if (!municipii.length) { uatSelect.style.display = 'none'; return; }
    municipii.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.s;
      opt.textContent = m.n + ' · ' + m.t + ' str.';
      uatSelect.appendChild(opt);
    });
    uatSelect.style.display = 'inline-block';
  }

  // ── Lookup tables (replicate Jinja2 dicts for JS-rendered panels) ─────────
  const NATURE_RO  = {'flower':'flori','tree':'copaci','water':'apă','plant':'plante','bird':'păsări','sky':'cer','geography':'geografie','forest':'pădure','meadow':'câmpie','season':'anotimpuri','animal':'animale','weather':'vreme','fruit':'fructe','field':'câmp','hill':'deal','orchard':'livadă','valley':'vale','peak':'vârf','mountain':'munte','mountain_peak':'vârf de munte'};
  const NATURE_EMO = {'flower':'🌸','tree':'🌳','water':'💧','plant':'🌱','bird':'🐦','sky':'☁️','geography':'🗺️','forest':'🌲','meadow':'🌾','season':'🍂','animal':'🦌','weather':'🌦️','fruit':'🍎','field':'🌾','hill':'⛰️','orchard':'🍒','valley':'🏞️','peak':'🏔️','mountain':'⛰️','mountain_peak':'🏔️'};
  const NATURE_SLUG = Object.fromEntries((DATA_S5.nature_subtypes || []).map(r => [r.nature_type, r.slug]));

  const PROF_RO  = {'writer':'scriitor','poet':'poet','politician':'politician','voievod':'voievod','revolutionary':'revoluționar','military':'militar','royalty':'rege / regină','scientist':'om de știință','painter':'pictor','ruler':'conducător','historian':'istoric','composer':'compozitor','engineer':'inginer','educator':'pedagog','clergy':'cleric','philosopher':'filosof','actor':'actor','architect':'arhitect','doctor':'medic','economist':'economist','jurist':'jurist','linguist':'lingvist','mathematician':'matematician','lawyer':'avocat'};
  const PROF_EMO = {'writer':'✍️','poet':'🪶','politician':'🏛️','voievod':'🗡️','revolutionary':'✊','military':'🎖️','royalty':'👑','scientist':'🔬','painter':'🎨','ruler':'⚜️','historian':'📜','composer':'🎼','engineer':'⚙️','educator':'🎓','clergy':'✝️','philosopher':'🧠','actor':'🎭','architect':'📐','doctor':'🩺','economist':'💼','jurist':'⚖️','linguist':'🗣️','mathematician':'➗','lawyer':'⚖️'};
  const PROF_SLUG = Object.fromEntries((DATA_S3.profession_dist || []).map(r => [r.profession, r.slug]));

  const ERA_RO  = {'ancient':'antichitate','medieval':'medieval','premodern':'premodern (1700–1900)','1848':'generația de la 1848','interwar':'interbelic (1900–1947)','communist':'comunism (1947–1989)'};
  const ERA_EMO = {'ancient':'🏺','medieval':'🏰','premodern':'🕯️','1848':'🗽','interwar':'🎩','communist':'⭐'};

  const IDEO_RO   = {'victory':'victorie','national_day':'zi națională','brotherhood':'frăție','youth':'tinerețe','workers':'muncitori','unification':'unire','triumph':'triumf','solidarity':'solidaritate','revolution':'revoluție','republic':'republică','rebirth':'renaștere','progress':'progres','peace':'pace','liberation':'eliberare','labor':'muncă','independence':'independență','homeland':'patrie','glory':'glorie','freedom':'libertate','fraternity':'frăternitate','equality':'egalitate','emancipation':'emancipare','democracy':'democrație','cooperative':'cooperativă','communist_press':'presă comunistă','commemorative':'comemorativ'};
  const IDEO_SLUG = Object.fromEntries((DATA_S5.ideo_tokens || []).map(r => [r.token, r.slug]));

  const NAT_FLAG = {'HU':'🇭🇺','FR':'🇫🇷','DE':'🇩🇪','IT':'🇮🇹','GB':'🇬🇧','RU':'🇷🇺','AT':'🇦🇹','PL':'🇵🇱','TR':'🇹🇷','US':'🇺🇸','GR':'🇬🇷','SR':'🇷🇸','UA':'🇺🇦','CZ':'🇨🇿','SK':'🇸🇰','BG':'🇧🇬','MD':'🇲🇩','HR':'🇭🇷','SI':'🇸🇮','CH':'🇨🇭','ES':'🇪🇸','PT':'🇵🇹','NL':'🇳🇱','BE':'🇧🇪','SE':'🇸🇪','NO':'🇳🇴','DK':'🇩🇰','FI':'🇫🇮','IL':'🇮🇱','JP':'🇯🇵'};
  const PROF_RO_SMALL = {'poet':'poet','writer':'scriitor','composer':'compozitor','royalty':'rege / voievod','politician':'politician','military':'militar','revolutionary':'revoluționar','scientist':'om de știință','painter':'pictor','philosopher':'filozof'};

  // ── Generic bar-row renderer (nature, profession, era) ────────────────────
  function _renderBarRows(rows, labelFn, emoFn, linkFn, barClass) {
    if (!rows || !rows.length) return '<div style="color:var(--muted);font-size:11.5px;padding:6px 0;font-style:italic;">(date insuficiente)</div>';
    const maxN = rows[0].n || 1;
    return rows.slice(0, 8).map((r, i) => {
      const label = escapeHtml(labelFn(r));
      const emo   = emoFn(r);
      const href  = linkFn(r);
      const pct   = Math.round(r.n / maxN * 100);
      const border = i > 0 ? 'border-top:1px solid var(--hairline);' : '';
      const nameEl = href
        ? `<a href="${href}" style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink);text-decoration:none;">${label}</a>`
        : `<span style="font-family:var(--sans);font-size:22px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${label}</span>`;
      return `<div style="display:flex;align-items:center;gap:8px;padding:3px 0;${border}"><span class="emo xxl" style="width:24px;text-align:center;">${emo}</span>${nameEl}<div class="bar-wrap" style="width:90px;"><div class="bar ${barClass}" style="width:${pct}%;"></div></div><span style="font-family:var(--sans);font-size:22px;font-weight:500;color:var(--ink);width:56px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-.005em;">${r.n}</span></div>`;
    }).join('');
  }

  function updateNatureSubtypes(rows) {
    const el = document.getElementById('s5-nature-list');
    if (el) el.innerHTML = _renderBarRows(rows,
      r => NATURE_RO[r.nature_type] || r.nature_type,
      r => NATURE_EMO[r.nature_type] || '·',
      r => NATURE_SLUG[r.nature_type] ? `/tema/${NATURE_SLUG[r.nature_type]}/` : null,
      'olive');
  }

  function updateProfessions(rows) {
    const el = document.getElementById('s3-prof-list');
    if (el) el.innerHTML = _renderBarRows(rows,
      r => PROF_RO[r.profession] || r.profession,
      r => PROF_EMO[r.profession] || '·',
      r => PROF_SLUG[r.profession] ? `/tema/${PROF_SLUG[r.profession]}/` : null,
      '');
  }

  function updateEras(rows) {
    const el = document.getElementById('s3-era-list');
    if (el) el.innerHTML = _renderBarRows(rows,
      r => ERA_RO[r.era] || r.era || 'necunoscută',
      r => ERA_EMO[r.era] || '·',
      () => null,
      '');
  }

  function updateIdeoTokens(rows) {
    const el = document.getElementById('s5-ideo-list');
    if (!el) return;
    if (!rows || !rows.length) {
      el.innerHTML = '<span style="font-style:italic;color:var(--muted);font-size:11.5px;">(date insuficiente)</span>';
      return;
    }
    el.innerHTML = rows.slice(0, 12).map(r => {
      const label = escapeHtml(IDEO_RO[r.token] || r.token);
      const slug  = IDEO_SLUG[r.token] || '';
      const isHigh = r.n > 10;
      const style = `font-family:var(--sans);font-size:20px;font-weight:500;padding:7px 14px;border:1.5px solid ${isHigh ? 'var(--accent)' : 'var(--rule-strong)'};border-radius:3px;color:${isHigh ? 'var(--accent-dark)' : 'var(--ink)'};background:${isHigh ? '#FFF1ED' : 'var(--bg)'};`;
      const inner = `${label} <span style="color:var(--muted);font-size:16px;margin-left:6px;font-variant-numeric:tabular-nums;font-weight:500;">${r.n}</span>`;
      return slug
        ? `<a href="/tema/${slug}/" style="${style}text-decoration:none;display:inline-flex;align-items:center;">${inner}</a>`
        : `<span style="${style}">${inner}</span>`;
    }).join('');
  }

  function updateForeigners(rows) {
    const panel = document.getElementById('s3-foreigners-panel');
    const list  = document.getElementById('s3-foreigners-list');
    const cnt   = document.getElementById('s3-foreigners-count');
    if (!list) return;
    if (!rows || !rows.length) {
      if (panel) panel.style.display = 'none';
      return;
    }
    if (panel) panel.style.display = '';
    if (cnt) cnt.textContent = rows.length + ' persoane';
    const maxF = rows[0].street_count || 1;
    list.innerHTML = rows.map(p => {
      const flag = NAT_FLAG[p.nationality] || '🏳️';
      const prof = escapeHtml(PROF_RO_SMALL[p.profession] || p.profession || '—');
      const pct  = Math.round(p.street_count / maxF * 100);
      const href = p.slug ? `/persoana/${p.slug}/` : null;
      const portrait = (p.wikidata_qid && PORTRAITS.has(p.wikidata_qid))
        ? `<span class="portrait" style="width:22px;height:22px;border-radius:50%;overflow:hidden;flex-shrink:0;display:inline-flex;"><img src="/portraits/${p.wikidata_qid}.jpg" alt="" style="width:100%;height:100%;object-fit:cover;" loading="lazy"></span>`
        : '';
      const nameInner = portrait + escapeHtml(p.full_name);
      const nameEl = href
        ? `<a href="${href}" style="color:inherit;text-decoration:none;display:flex;align-items:center;gap:7px;"><span class="rank-name person">${nameInner}</span></a>`
        : `<span class="rank-name person" style="display:flex;align-items:center;gap:7px;">${nameInner}</span>`;
      return `<div class="rank-row" style="grid-template-columns:32px minmax(0,1fr) minmax(50px,0.9fr) 48px 80px;"><span style="font-size:20px;line-height:1;text-align:center;">${flag}</span>${nameEl}<span style="font-family:var(--sans);font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${prof}</span><div class="bar-wrap"><div class="bar" style="width:${pct}%"></div></div><span class="rank-count">${p.street_count}</span></div>`;
    }).join('');
  }

  // ── Theme panel helpers ───────────────────────────────────────────────────
  const THEME_COLORS = ['#5F7A4E','#0E4D92','#5A6573','#C04F35','#E8AE00','#7A4A33','#B0B7C0'];
  const THEME_ORDER  = ['natură','persoană','concept / abstract','ideologic','dată / sărbătoare','religios'];

  function updateTheme(themeData) {
    const total = themeData ? themeData.total : 0;
    // Update donut gradient
    let cum = 0;
    const gradParts = THEME_ORDER.map((cat, i) => {
      const count = themeData ? (themeData[cat] || 0) : 0;
      const pct   = total > 0 ? count / total * 100 : 0;
      const part  = `${THEME_COLORS[i]} ${cum.toFixed(1)}% ${(cum + pct).toFixed(1)}%`;
      cum += pct;
      return part;
    });
    const donut = document.getElementById('s5-donut');
    if (donut) donut.style.background = `conic-gradient(${gradParts.join(',')})`;
    // Update total label
    const totEl = document.getElementById('s5-donut-total');
    if (totEl) totEl.textContent = total.toLocaleString('ro-RO');
    // Update percentage labels
    document.querySelectorAll('[data-cat]').forEach(row => {
      const cat   = row.dataset.cat;
      const count = themeData ? (themeData[cat] || 0) : 0;
      const pct   = total > 0 ? (count / total * 100).toFixed(1) : '0.0';
      const span  = row.querySelector('.s5-pct');
      if (span) span.textContent = pct + '%';
    });
  }

  // ── Gender grid helper ────────────────────────────────────────────────────
  function updateGenderGrid(m, f) {
    const total = m + f;
    const grid  = document.getElementById('s3-gap-grid');
    if (!grid) return;
    // Create squares on first call
    if (!grid.children.length) {
      for (let i = 0; i < 100; i++) {
        const sq = document.createElement('div');
        sq.style.cssText = 'width:11px;height:11px;border-radius:1px;';
        grid.appendChild(sq);
      }
    }
    const femaleSquares = total > 0 ? Math.max(1, Math.round(f / total * 100)) : 0;
    Array.from(grid.children).forEach((sq, i) => {
      sq.style.background = i >= (100 - femaleSquares) ? 'var(--accent)' : 'var(--ink)';
    });
    const mEl = document.getElementById('s3-gender-m');
    const tEl = document.getElementById('s3-gender-tot');
    if (mEl) mEl.textContent = m.toLocaleString('ro-RO');
    if (tEl) tEl.textContent = total.toLocaleString('ro-RO');
  }

  // ── Pageviews list helper ─────────────────────────────────────────────────
  function updatePageviews(rows) {
    const container = document.getElementById('s4-pv-list');
    if (!container) return;
    if (!rows || !rows.length) {
      container.innerHTML = '<div style="color:var(--muted);font-size:11.5px;padding:6px 0;">(fără date)</div>';
      return;
    }
    const maxPV = rows[0].wiki_ro_views || 1;
    container.innerHTML = rows.map(p => {
      const pct  = maxPV > 0 ? Math.round(p.wiki_ro_views / maxPV * 100) : 0;
      const href = p.slug ? `/persoana/${p.slug}/` : null;
      const name = href
        ? `<a href="${href}" style="color:inherit;text-decoration:none;"><span class="rank-name person">${escapeHtml(p.full_name)}</span></a>`
        : `<span class="rank-name person">${escapeHtml(p.full_name)}</span>`;
      const barCls = p.wiki_scope === 'universal' ? 'bar accent' : 'bar';
      const tag = `<span class="tag${p.wiki_scope === 'universal' ? ' person' : ''}">${p.wiki_scope || '—'}</span>`;
      return `<div class="rank-row">${name}<div class="bar-wrap"><div class="${barCls}" style="width:${pct}%"></div></div><span class="rank-count">${(p.wiki_ro_views || 0).toLocaleString('ro-RO')}</span>${tag}</div>`;
    }).join('');
  }

  function renderFlat(rows, rootId, isPersons) {
    const root = document.getElementById(rootId);
    root.innerHTML = '';
    if (!rows || !rows.length) {
      root.innerHTML = '<div style="color:var(--muted);font-size:11.5px;padding:6px 0;">(fără date)</div>';
      return;
    }
    const keyFn = r => isPersons ? r.full_name : r.name_normalized;
    const labelFn = r => isPersons ? r.full_name : (r.core_name || r.name_normalized);
    const counts = rows.map(r => r.street_count);
    const lo = Math.min(...counts), hi = Math.max(...counts);
    const leaders = new Set(
      rows.slice().sort((a, b) => b.street_count - a.street_count)
                 .slice(0, OVERALL_LEADERS).map(keyFn)
    );
    const tokens = rows.map(r => {
      const fs = fontFor(r.street_count, lo, hi).toFixed(1);
      const isLeader = leaders.has(keyFn(r));
      const cnt = `<sup class="cnt-badge">${r.street_count.toLocaleString('ro-RO')}</sup>`;
      if (isPersons) {
        const qid = r.wikidata_qid;
        const hasPortrait = (qid && PORTRAITS.has(qid));
        const portrait = hasPortrait
          ? `<span class="portrait"><img src="/portraits/${qid}.jpg" alt="" loading="lazy"></span>`
          : '';
        const personSlug = r.slug || (qid ? qid.toLowerCase() : '');
        const personHref = personSlug ? `/persoana/${personSlug}/` : null;
        const chip = `<span class="chip" style="font-size:${fs}px;">${escapeHtml(labelFn(r))}</span>`;
        const inner = portrait + (personHref ? `<a href="${personHref}" style="color:inherit;text-decoration:none;">${chip}</a>` : chip) + cnt;
        return `<span class="ctok person${isLeader ? ' leader' : ''}${hasPortrait ? ' has-portrait' : ''}">${inner}</span>`;
      }
      const sqid = r.wikidata_qid;
      const sPortrait = (sqid && PORTRAITS.has(sqid))
        ? `<span class="portrait"><img src="/portraits/${sqid}.jpg" alt="" loading="lazy"></span>`
        : '';
      const streetSlug = r.slug || '';
      const streetHref = streetSlug ? `/strada/${streetSlug}/` : null;
      const plaque = `<span class="plaque" style="font-size:${fs}px;">${escapeHtml(labelFn(r))}</span>`;
      const innerS = sPortrait + (streetHref ? `<a href="${streetHref}" style="color:inherit;text-decoration:none;">${plaque}</a>` : plaque) + cnt;
      return `<span class="ctok street${isLeader ? ' leader' : ''}${sPortrait ? ' has-portrait' : ''}">${innerS}</span>`;
    }).join('');
    root.innerHTML = `<div class="flat-tokens">${tokens}</div>`;
  }

  function setSubCount(id, n) {
    const el = document.getElementById(id);
    if (el) el.textContent = n ? (n + (n === 1 ? ' nume' : ' nume')) : '—';
  }

  function render(code, siruta) {
    let streets, men, women, foreigners, themeData, genderData, pvRows, footerText;
    let natRows, ideoRows, profRows, eraRows, foreignersFull;
    const isUat   = !!(siruta && siruta !== 'all');
    const isNat   = (code === 'all' && !isUat);

    if (isUat) {
      // UAT level
      const m = DATA_MUNICIPII;
      const expandStreet = r => ({
        core_name: r.n, name_normalized: r.nn, street_count: r.c,
        wikidata_qid: null, slug: r.sl, category: r.cat
      });
      const expandPerson = r => ({
        full_name: r.n, wikidata_qid: r.qid, street_count: r.c, slug: r.sl, gender: null
      });
      streets       = ((m.streets || {})[siruta] || []).map(expandStreet);
      men           = ((m.men  || {})[siruta] || []).map(expandPerson);
      women         = ((m.women|| {})[siruta] || []).map(expandPerson);
      foreigners    = [];
      themeData     = (m.themes || {})[siruta] || null;
      genderData    = (m.gender || {})[siruta] || null;
      pvRows        = null;
      natRows = ideoRows = profRows = eraRows = null;  // no UAT-level breakdown
      foreignersFull = [];
      const uatName = uatSelect.options[uatSelect.selectedIndex]?.text?.split(' · ')[0] || siruta;
      footerText = `municipiul ${uatName}`;
    } else if (isNat) {
      streets        = DATA_S2.top_names.slice(0, LIMIT_STREETS);
      men            = DATA_S3.top_men || [];
      women          = DATA_S3.top_women || [];
      foreigners     = DATA_S3.top_foreigners || [];
      themeData      = null;
      genderData     = null;
      pvRows         = DATA_S4.top_pageviews || [];
      natRows        = DATA_S5.nature_subtypes || [];
      ideoRows       = DATA_S5.ideo_tokens || [];
      profRows       = DATA_S3.profession_dist || [];
      eraRows        = DATA_S3.era_dist || [];
      foreignersFull = DATA_S3.top_foreigners || [];
      footerText = `top ${streets.length} · la nivel național`;
    } else {
      // Județ level
      const label = (JUDET_NAMES[code] || code) + ' (' + code + ')';
      streets        = (DATA_S2.by_judet || {})[code] || [];
      men            = (DATA_S3.men_by_judet || {})[code] || [];
      women          = (DATA_S3.women_by_judet || {})[code] || [];
      foreigners     = (DATA_S3.foreigners_by_judet || {})[code] || [];
      themeData      = (DATA_S5.theme_by_judet || {})[code] || null;
      genderData     = (DATA_S3.gender_by_judet || {})[code] || null;
      pvRows         = (DATA_S4.top_pageviews_by_judet || {})[code] || [];
      natRows        = (DATA_S5.nature_by_judet || {})[code] || [];
      ideoRows       = (DATA_S5.ideo_by_judet || {})[code] || [];
      profRows       = (DATA_S3.profession_by_judet || {})[code] || [];
      eraRows        = (DATA_S3.era_by_judet || {})[code] || [];
      foreignersFull = (DATA_S3.foreigners_by_judet || {})[code] || [];
      footerText = `județul ${label}`;
    }

    renderFlat(streets, 's2-clusters', false);
    renderFlat(men,    's3p-men',    true);
    renderFlat(women,  's3p-women',  true);
    renderFlat(foreigners, 's3p-foreigners', true);
    setSubCount('s3p-men-count', men.length);
    setSubCount('s3p-women-count', women.length);
    setSubCount('s3p-foreigners-count', foreigners.length);
    document.getElementById('s2-footer').textContent = footerText;

    // Theme donut
    if (themeData) {
      updateTheme(themeData);
    } else if (isNat) {
      const natTotal = DATA_S5.theme_dist.reduce((s, t) => s + t.count, 0);
      const natMap = Object.fromEntries(DATA_S5.theme_dist.map(t => [t.category, t.count]));
      natMap.total = natTotal;
      updateTheme(natMap);
    }

    // Gender grid
    const gm = genderData ? genderData.m : (isNat ? DATA_S3.total_m : 0);
    const gf = genderData ? genderData.f : (isNat ? DATA_S3.total_f : 0);
    updateGenderGrid(gm, gf);

    // Pageviews list
    if (pvRows !== null) updatePageviews(pvRows);

    // Nature subtypes, ideo tokens, professions, eras
    updateNatureSubtypes(natRows);
    updateIdeoTokens(ideoRows);
    updateProfessions(profRows);
    updateEras(eraRows);

    // Foreigners full panel
    updateForeigners(foreignersFull);

    // Contests panel: national only
    const contestsPanel = document.getElementById('s8-contests-panel');
    if (contestsPanel) contestsPanel.style.display = isNat ? '' : 'none';
  }

  function updateUrl(code, siruta) {
    const p = new URLSearchParams();
    if (code && code !== 'all') p.set('judet', code);
    if (siruta && siruta !== 'all') p.set('siruta', String(siruta));
    const qs = p.toString();
    history.replaceState({}, '', qs ? '?' + qs : location.pathname);
  }

  select.addEventListener('change', e => {
    syncUatSelect(e.target.value);
    uatSelect.value = 'all';
    render(e.target.value, null);
    updateUrl(e.target.value, null);
  });
  uatSelect.addEventListener('change', e => {
    render(select.value, e.target.value);
    updateUrl(select.value, e.target.value);
  });
  (function initFromUrl() {
    const p      = new URLSearchParams(window.location.search);
    const judet  = p.get('judet');
    const siruta = p.get('siruta');
    if (judet && (DATA_S2.by_judet || {})[judet] !== undefined) {
      select.value = judet;
      syncUatSelect(judet);
      const validSirute = ((DATA_MUNICIPII.by_judet || {})[judet] || []).map(m => String(m.s));
      if (siruta && validSirute.includes(siruta)) {
        uatSelect.value = siruta;
        render(judet, siruta);
        updateUrl(judet, siruta);
      } else {
        render(judet, null);
        updateUrl(judet, null);
      }
    } else {
      render('all', null);
      updateUrl('all', null);
    }
  })();
})();
</script>


</body>
</html>
