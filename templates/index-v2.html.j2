</nav>

{# Stats widget — V3b · responsive 4→2→1 columns #}
{% set total_gendered = section1.total_persons_m + section1.total_persons_f %}
{% set male_pct = (section1.total_persons_m / total_gendered * 100) | round | int if total_gendered else 0 %}
{% set female_pct = 100 - male_pct if total_gendered else 0 %}
{% set total_persons = section3.total_m + section3.total_f %}
{# Tematică: top category as headline, top-4 named, remainder grouped as "altele".
   Colours match the conic-gradient in the Repartiție tematică panel below. #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_palette = ['#C04F35','#A0826A','#8BA888','#6E6E70','#B8A090','#3A3A3D','#DDDCD7'] %}
{% set theme_ro = {
  'natură':'natură','persoană':'persoane','concept / abstract':'abstract',
  'ideologic':'ideologic','dată / sărbătoare':'date','religios':'religios'
} %}
{% set top4 = section5.theme_dist[:4] %}
{% set rest = section5.theme_dist[4:] %}
{% set rest_count = rest | sum(attribute='count') %}
{% set lead = section5.theme_dist[0] %}
{% set lead_pct = (lead.count / theme_total * 100) | round | int %}
<div class="statbar">

  <div class="group">
    <div class="group-label"><span class="emo md">📊</span> Scară</div>
    <div class="scale-stack">
      <div class="item">
        <div class="v">{{ "{:,.0f}".format(section1.total_streets).replace(",", ".") }}</div>
        <div class="l">Adrese</div>
      </div>
      <div class="item">
        <div class="v">{{ total_persons }}</div>
        <div class="l">Persoane onorate</div>
      </div>
    </div>
  </div>

  <div class="group">
    <div class="group-label"><span class="emo md">🏷️</span> Tematică</div>
    <div class="tema-row">
      <div class="v">{{ lead_pct }}<span class="u">% {{ theme_ro[lead.category] | default(lead.category) }}</span></div>
    </div>
    <div class="minibar">
      {% for t in top4 %}
        {% set pct = (t.count / theme_total * 100) %}
        <div style="width:{{ pct }}%;background:{{ theme_palette[loop.index0] }};"></div>
      {% endfor %}
      {% if rest_count %}
        {% set rest_pct = (rest_count / theme_total * 100) %}
        <div style="width:{{ rest_pct }}%;background:{{ theme_palette[4] }};"></div>
      {% endif %}
    </div>
    <div class="l">
      {% for t in top4[1:] %}
        {% set pct = (t.count / theme_total * 100) | round | int %}
        {{ theme_ro[t.category] | default(t.category) }} <strong style="color:var(--ink);">{{ pct }}%</strong>{{ ' · ' if not loop.last }}
      {% endfor %}
    </div>
  </div>

  <div class="group">
    <div class="group-label"><span class="emo md">⚥</span> Repartiție pe gen</div>
    <div class="gen-row">
      <div class="v">{{ male_pct }}<span class="u">% B</span></div>
      <div class="frac">/ <span class="accent" style="font-weight:600;">{{ female_pct }}% F</span></div>
    </div>
    <div class="minibar">
      <div style="width:{{ male_pct }}%;background:rgba(0,0,0,.42);"></div>
      <div style="width:{{ female_pct }}%;background:var(--accent);"></div>
    </div>
    <div class="l">Persoane onorate, M vs F</div>
  </div>

  <div class="group">
    <div class="group-label"><span class="emo md">🏆</span> Cei mai des onorați</div>
    <div class="top-pair">
      {% if section1.top_men %}
      <div class="row">
        <span class="prefix">#1 B</span>
        <span class="name">{{ section1.top_men[0].full_name }}</span>
        <span class="cnt">{{ section1.top_men[0].street_count }}<span class="u">str.</span></span>
      </div>
      {% endif %}
      {% if section1.top_women %}
      <div class="row">
        <span class="prefix">#1 F</span>
        <span class="name">{{ section1.top_women[0].full_name }}</span>
        <span class="cnt">{{ section1.top_women[0].street_count }}<span class="u">str.</span></span>
      </div>
      {% endif %}
    </div>
  </div>

</div>

<div class="dash-grid">

{# PANEL: CELE MAI FRECVENTE (s12, 2-col rank list) #}
<div class="panel s12" id="cele-mai-intalnite">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">🔝</span> Cele mai frecvente · Top 30</span>
    <div class="s2-judet-pick">
      <label for="s2-judet-select">Județ</label>
      <select id="s2-judet-select">
        <option value="all">Toate județele</option>
        {# Options populated by JS #}
      </select>
    </div>
  </div>
  <div class="rank-list rank-2col s2-list" id="s2-list">
    {# Populated by JS #}
  </div>
  <div style="font-family:var(--sans);font-size:10.5px;color:var(--muted);padding:8px 0 0;" id="s2-footer"></div>
</div>

{# PANEL: REPARTIȚIE TEMATICĂ (s4) #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_colors = ['#5F7A4E','#0E4D92','#5A6573','#C04F35','#E8AE00','#7A4A33','#B0B7C0'] %}
{% set theme_emoji = {
  'natură':'🌿','persoană':'👤','concept / abstract':'💭',
  'ideologic':'🚩','dată / sărbătoare':'📅','religios':'⛪'
} %}
{% set ns = namespace(cumulative=0) %}
<div class="panel s4" id="tematica">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">🧭</span> Repartiție tematică</span>
    <span class="panel-meta">{{ "{:,.0f}".format(theme_total).replace(",", ".") }} clasif.</span>
  </div>
  <div style="display:flex;gap:18px;align-items:center;">
    <div style="position:relative;width:96px;height:96px;flex-shrink:0;">
      <div style="width:96px;height:96px;border-radius:50%;background:conic-gradient(
        {% for t in section5.theme_dist %}
        {% set pct = (t.count / theme_total * 100) | round(1) %}
        {{ theme_colors[loop.index0 % theme_colors|length] }} {{ ns.cumulative }}% {{ ns.cumulative + pct }}%{{ ',' if not loop.last }}
        {% set ns.cumulative = ns.cumulative + pct %}
        {% endfor %}
      );"></div>
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;background:var(--bg);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">
        <div class="display-num" style="font-size:15px;">{{ "{:,.0f}".format(theme_total).replace(",", ".") }}</div>
        <div style="font-family:var(--sans);font-size:8.5px;color:var(--muted);letter-spacing:.06em;">total</div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:5px;flex:1;min-width:0;">
      {% for t in section5.theme_dist %}
      {% set pct = (t.count / theme_total * 100) | round(1) %}
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:10px;height:10px;border-radius:2px;background:{{ theme_colors[loop.index0 % theme_colors|length] }};flex-shrink:0;"></div>
        <span class="emo md">{{ theme_emoji.get(t.category, '·') }}</span>
        <span style="font-family:var(--sans);font-size:12px;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ t.category }}</span>
        <span style="font-family:var(--sans);font-size:12.5px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.01em;">{{ pct }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# PANEL: SUBTIPURI NATURĂ (s4) #}
{% set nature_ro = {
  'flower':'flori','tree':'copaci','water':'apă','plant':'plante',
  'bird':'păsări','sky':'cer','geography':'geografie','forest':'pădure',
  'meadow':'câmpie','season':'anotimpuri','animal':'animale',
  'weather':'vreme','fruit':'fructe','field':'câmp','hill':'deal',
  'orchard':'livadă','valley':'vale','peak':'vârf','mountain':'munte',
  'mountain_peak':'vârf de munte'
} %}
{% set nature_emoji = {
  'flower':'🌸','tree':'🌳','water':'💧','plant':'🌱','bird':'🐦',
  'sky':'☁️','geography':'🗺️','forest':'🌲','meadow':'🌾','season':'🍂',
  'animal':'🦌','weather':'🌦️','fruit':'🍎','field':'🌾','hill':'⛰️',
  'orchard':'🍒','valley':'🏞️','peak':'🏔️','mountain':'⛰️','mountain_peak':'🏔️'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">🌿</span> Subtipuri · Natură</span>
  </div>
  {% set max_n = section5.nature_subtypes[0].n if section5.nature_subtypes else 1 %}
  {% for row in section5.nature_subtypes %}
  <div style="display:flex;align-items:center;gap:8px;padding:3px 0;{% if not loop.first %}border-top:1px solid var(--hairline);{% endif %}">
    <span class="emo md" style="width:14px;text-align:center;">{{ nature_emoji.get(row.nature_type, '·') }}</span>
    <span style="font-family:var(--sans);font-size:12px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ nature_ro.get(row.nature_type, row.nature_type) }}</span>
    <div class="bar-wrap" style="width:90px;"><div class="bar olive" style="width:{{ (row.n / max_n * 100)|int }}%;"></div></div>
    <span style="font-family:var(--sans);font-size:12px;font-weight:700;color:var(--ink);width:30px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-.005em;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: TOKENI IDEOLOGICI (s4) #}
{% set ideo_ro = {
  'victory':'victorie','national_day':'zi națională','brotherhood':'frăție',
  'youth':'tinerețe','workers':'muncitori','unification':'unire',
  'triumph':'triumf','solidarity':'solidaritate','revolution':'revoluție',
  'republic':'republică','rebirth':'renaștere','progress':'progres',
  'peace':'pace','liberation':'eliberare','labor':'muncă',
  'independence':'independență','homeland':'patrie','glory':'glorie',
  'freedom':'libertate','fraternity':'frăternitate','equality':'egalitate',
  'emancipation':'emancipare','democracy':'democrație','cooperative':'cooperativă',
  'communist_press':'presă comunistă','commemorative':'comemorativ'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">🚩</span> Tokeni ideologici</span>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:6px;">
    {% for tok in section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:11.5px;font-weight:600;padding:3px 9px;border:1.5px solid {{ 'var(--accent)' if tok.n > 30 else 'var(--rule-strong)' }};border-radius:2px;color:{{ 'var(--accent-dark)' if tok.n > 30 else 'var(--ink)' }};background:{{ '#FFF1ED' if tok.n > 30 else 'var(--bg)' }};">
      {{ ideo_ro.get(tok.token, tok.token) }} <span style="color:var(--muted);font-size:10px;margin-left:3px;font-variant-numeric:tabular-nums;font-weight:500;">{{ tok.n }}</span>
    </span>
    {% endfor %}
    {% if not section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:11.5px;font-style:italic;color:var(--muted);">Subcategorii în curs de completare.</span>
    {% endif %}
  </div>
</div>

{# PANEL: ECART DE GEN (s4) #}
<div class="panel s4" id="pe-cine-onoram">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">⚥</span> Ecart de gen</span>
    <span class="panel-meta">{{ section3.total_m + section3.total_f }} pers.</span>
  </div>
  <div style="display:flex;gap:16px;align-items:start;">
    <div>
      <div style="font-family:var(--sans);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;">Fiecare pătrat = 1 persoană</div>
      <div id="s3-gap-grid" style="display:grid;grid-template-columns:repeat(10,11px);gap:2px;width:130px;"></div>
      <div style="display:flex;gap:10px;margin-top:8px;font-family:var(--sans);font-size:10px;">
        <div style="display:flex;align-items:center;gap:5px;">
          <div style="width:8px;height:8px;border-radius:1px;background:var(--ink)"></div><span style="color:var(--muted)">Bărbat</span>
        </div>
        <div style="display:flex;align-items:center;gap:5px;">
          <div style="width:8px;height:8px;border-radius:1px;background:var(--accent)"></div><span style="color:var(--muted)">Femeie</span>
        </div>
      </div>
    </div>
    <div>
      <div class="display-num" style="font-size:36px;margin-bottom:2px;">
        {{ section3.total_m }}<span style="font-size:20px;color:var(--muted);font-weight:500;">/{{ section3.total_m + section3.total_f }}</span>
      </div>
      <div style="font-family:var(--sans);font-size:10.5px;color:var(--muted);">bărbați din total</div>
    </div>
  </div>
</div>

{# PANEL: PROFESII (s4) #}
{% set prof_ro = {
  'writer':'scriitor','poet':'poet','politician':'politician',
  'voievod':'voievod','revolutionary':'revoluționar','military':'militar',
  'royalty':'rege / regină','scientist':'om de știință','painter':'pictor',
  'ruler':'conducător','historian':'istoric','composer':'compozitor',
  'engineer':'inginer','educator':'pedagog','clergy':'cleric',
  'philosopher':'filosof','actor':'actor','architect':'arhitect',
  'doctor':'medic','economist':'economist','jurist':'jurist',
  'linguist':'lingvist','mathematician':'matematician','lawyer':'avocat'
} %}
{% set prof_emoji = {
  'writer':'✍️','poet':'🪶','politician':'🏛️','voievod':'🗡️',
  'revolutionary':'✊','military':'🎖️','royalty':'👑','scientist':'🔬',
  'painter':'🎨','ruler':'⚜️','historian':'📜','composer':'🎼',
  'engineer':'⚙️','educator':'🎓','clergy':'✝️','philosopher':'🧠',
  'actor':'🎭','architect':'📐','doctor':'🩺','economist':'💼',
  'jurist':'⚖️','linguist':'🗣️','mathematician':'➗','lawyer':'⚖️'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">🎓</span> Profesia persoanei onorate</span>
  </div>
  {% set max_prof = section3.profession_dist[0].n if section3.profession_dist else 1 %}
  {% for row in section3.profession_dist %}
  <div style="display:flex;align-items:center;gap:8px;padding:3px 0;{% if not loop.first %}border-top:1px solid var(--hairline);{% endif %}">
    <span class="emo md" style="width:14px;text-align:center;">{{ prof_emoji.get(row.profession, '·') }}</span>
    <span style="font-family:var(--sans);font-size:12px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ prof_ro.get(row.profession, row.profession) }}</span>
    <div class="bar-wrap" style="width:90px;">
      <div class="bar" style="width:{{ (row.n / max_prof * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:12px;font-weight:700;color:var(--ink);width:26px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-.005em;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: EPOCI (s4) #}
{% set era_ro = {
  'ancient':'antichitate','medieval':'medieval','premodern':'premodern (1700–1900)',
  '1848':'generația de la 1848','interwar':'interbelic (1900–1947)',
  'communist':'comunism (1947–1989)'
} %}
{% set era_emoji = {
  'ancient':'🏺','medieval':'🏰','premodern':'🕯️',
  '1848':'🗽','interwar':'🎩','communist':'⭐'
} %}
<div class="panel s4">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">⏳</span> Epoca în care a trăit</span>
  </div>
  {% set max_era = section3.era_dist[0].n if section3.era_dist else 1 %}
  {% for row in section3.era_dist %}
  <div style="display:flex;align-items:center;gap:8px;padding:3px 0;{% if not loop.first %}border-top:1px solid var(--hairline);{% endif %}">
    <span class="emo md" style="width:14px;text-align:center;">{{ era_emoji.get(row.era, '·') }}</span>
    <span style="font-family:var(--sans);font-size:12px;font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ era_ro.get(row.era, row.era or 'necunoscută') }}</span>
    <div class="bar-wrap" style="width:90px;">
      <div class="bar" style="width:{{ (row.n / max_era * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:12px;font-weight:700;color:var(--ink);width:26px;text-align:right;font-variant-numeric:tabular-nums;letter-spacing:-.005em;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: TOP PERSOANE (s12, 2-col internal) #}
<div class="panel s12">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">👥</span> Top persoane onorate · număr de străzi</span>
    <span class="panel-meta">{{ section3.top_persons | length }} pers. · <span style="color:var(--accent);font-weight:700;">●</span> feminin</span>
  </div>
  <div class="rank-list rank-2col s3-tower">
    {% set max_count = section3.top_persons[0].street_count %}
    {% for p in section3.top_persons %}
    <div class="rank-row">
      <span class="rank-name person">
        <span class="portrait lg" aria-hidden="true">{% if p.wikidata_qid and p.wikidata_qid in portraits %}<img src="/portraits/{{ p.wikidata_qid }}.jpg" alt="" loading="lazy">{% else %}{{ (p.full_name.split()[0][0] if p.full_name else '·') }}{{ (p.full_name.split()[-1][0] if p.full_name and (p.full_name.split() | length) > 1 else '') }}{% endif %}</span>
        {{ p.full_name }}{% if p.gender == 'F' %} <span style="display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-left:4px;vertical-align:middle;"></span>{% endif %}
      </span>
      <div class="bar-wrap">
        <div class="{{ 'bar accent' if loop.first else ('bar female' if p.gender == 'F' else 'bar') }}"
             style="width:{{ (p.street_count / max_count * 100)|int }}%"></div>
      </div>
      <span class="rank-count">{{ p.street_count }}</span>
    </div>
    {% endfor %}
  </div>
</div>

{# PANEL: RECUNOAȘTERE GLOBALĂ (s6) #}
<div class="panel s6" id="recunoastere">
  <div class="panel-header">
    <span class="panel-label"><span class="emo md">🌍</span> Recunoaștere globală · Wikidata</span>
    <span class="panel-meta">{{ wikidata_total }} persoane</span>
