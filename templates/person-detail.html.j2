{# templates/person-detail.html.j2 — detail page for a person #}
{% extends "_detail-shell.html.j2" %}

{% set p = person %}

{% block title %}{{ p.full_name }} — Cum ne numim străzile{% endblock %}

{% block body %}
<div class="detail-page">

  <div class="breadcrumb">
    <a href="{{ base }}/">Acasă</a>
    <span class="sep">›</span>
    <a href="{{ base }}/persoane/">Persoane</a>
    <span class="sep">›</span>
    <span>{{ p.full_name }}</span>
  </div>

  <div class="detail-hero">
    <div class="kicker"><span class="emo">👤</span> Persoană</div>
    <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap; margin-top:10px;">
      {% if p.wikidata_qid %}
      <div class="portrait xl">
        <img src="{{ base }}/portraits/{{ p.wikidata_qid }}.jpg" alt="{{ p.full_name }}"
             onerror="this.parentElement.textContent='{{ p.full_name[:2] | upper }}'">
      </div>
      {% endif %}
      <div>
        <h1 style="font-size:32px; font-weight:700; font-family:var(--street); letter-spacing:.02em; margin-bottom:8px;">{{ p.full_name }}</h1>
        <div class="meta-row">
          {% if p.profession %}<span>{{ p.profession }}</span>{% endif %}
          {% if p.era %}<span>· {{ p.era }}</span>{% endif %}
          {% if p.nationality and p.nationality != 'RO' %}<span>· <span class="tag">{{ p.nationality }}</span></span>{% endif %}
        </div>
        <div style="margin-top:10px; font-size:12px; color:var(--muted);">
          {% if p.wiki_ro_url %}<a href="{{ p.wiki_ro_url }}" target="_blank" rel="noopener">↗ Wikipedia română</a>{% endif %}
          {% if p.wikidata_qid %}
            {% if p.wiki_ro_url %} · {% endif %}
            <a href="https://www.wikidata.org/wiki/{{ p.wikidata_qid }}" target="_blank" rel="noopener">Wikidata {{ p.wikidata_qid }}</a>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="meta-row" style="margin-top:14px;">
      <span><strong>{{ total }}</strong> strad{% if total == 1 %}ă{% else %}ăzi{% endif %} numite după această persoană</span>
      <span>în <strong>{{ uat_count }}</strong> localități din <strong>{{ judet_count }}</strong> județe</span>
    </div>
  </div>

  <div class="detail-section">
    <div class="detail-section-header">Prezență geografică</div>
    {% for bucket in per_judet %}
    <div class="judet-section">
      <div class="judet-label">{{ bucket.judet }} — {{ bucket.total }} stradă{% if bucket.total != 1 %}zi{% endif %}</div>
      <div class="uat-cluster">
        {% for u in bucket.uats %}
          <a class="uat-pill" href="{{ base }}/oras/{{ bucket.judet | lower }}/{{ u.uat_slug }}/">{{ u.uat | title }}</a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  {% if peers %}
  <div class="detail-section">
    <div class="detail-section-header">Personalități similare{% if p.profession %} · {{ p.profession }}{% endif %}{% if p.era %} · {{ p.era }}{% endif %}</div>
    <div class="rank-list" style="max-width:420px;">
      {% for peer in peers %}
      <div class="rank-row" style="grid-template-columns: minmax(0,1fr) 50px;">
        <div>
          {% if peer.wikidata_qid %}
          <span class="portrait" style="margin-right:6px;">
            <img src="{{ base }}/portraits/{{ peer.wikidata_qid }}.jpg" alt="{{ peer.full_name }}"
                 onerror="this.parentElement.textContent='{{ peer.full_name[:2] | upper }}'">
          </span>
          {% endif %}
          <a href="{{ base }}/persoana/{{ peer.slug }}/">{{ peer.full_name }}</a>
        </div>
        <div class="rank-count">{{ peer.street_count }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}
