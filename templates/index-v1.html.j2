<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cum ne numim străzile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3"></script>
  <script>
const DATA_S2 = {{ section2 | tojson }};
const DATA_S3 = {{ section3 | tojson }};
const DATA_S4 = {{ section4 | tojson }};
const DATA_S5 = {{ section5 | tojson }};
const DATA_S6 = {{ section6 | tojson }};
const DATA_S8 = {{ section8 | tojson }};
  </script>
  <style>
:root {
  --bg: #FAF8F3;
  --ink: #15171A;
  --muted: #6E6E70;
  --rule: #DDDCD7;
  --wash: #EEEAE0;
  --accent: #C04F35;
  --serif: 'Source Serif 4', Georgia, serif;
  --sans: 'Inter', system-ui, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}

/* Nav */
.site-nav {
  position: sticky; top: 0; z-index: 100;
  background: var(--bg);
  border-bottom: 1px solid var(--rule);
  padding: 14px 36px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--sans);
  font-size: 11.5px;
  letter-spacing: .06em;
}
.site-nav .brand {
  font-weight: 600;
  color: var(--ink);
  letter-spacing: .12em;
  text-transform: uppercase;
  text-decoration: none;
}
.site-nav nav { display: flex; gap: 22px; }
.site-nav nav a { color: var(--muted); text-decoration: none; }
.site-nav nav a:hover { color: var(--ink); }

/* Stats bar */
.stats-bar {
  background: var(--ink); color: #FAF8F3; padding: 10px 36px;
  display: flex; gap: 28px; flex-wrap: wrap;
  font-family: var(--sans); font-size: 12px; align-items: center;
}
.stats-bar .stat-val { font-weight: 600; margin-right: 3px; }
.stats-bar .stat-sep { color: #444; }

/* Panel grid */
.dash-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 1px; background: var(--rule);
}
.panel { background: var(--bg); padding: 20px 22px 16px; }
.panel.wide { grid-column: span 2; }

/* Panel header */
.panel-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--rule);
}
.panel-label {
  font-family: var(--sans); font-size: 10px; letter-spacing: .14em;
  text-transform: uppercase; font-weight: 600; color: var(--muted);
}

/* Caption */
.panel-caption {
  font-family: var(--sans); font-size: 11px; color: var(--muted);
  margin-top: 12px; line-height: 1.5;
}

/* Kicker */
.kicker {
  font-family: var(--sans);
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 500;
  margin-bottom: 22px;
}

/* Chip toggles */
.chip-row {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  margin-bottom: 24px; padding-bottom: 18px;
  border-bottom: 1px solid var(--rule);
  font-family: var(--sans); font-size: 11px;
}
.chip-row .label {
  letter-spacing: .12em; text-transform: uppercase;
  font-weight: 500; color: var(--muted);
}
.chip {
  font-family: var(--sans); font-size: 12px;
  color: var(--muted);
  padding: 5px 13px;
  border: 1px solid var(--rule); border-radius: 999px;
  background: transparent; cursor: pointer;
  transition: background .15s, color .15s;
}
.chip:hover, .chip.active {
  color: var(--bg); background: var(--ink); border-color: var(--ink);
}

/* Tag pills */
.tag {
  font-family: var(--sans); font-size: 10px;
  color: var(--muted); background: var(--wash);
  padding: 2px 7px; border-radius: 999px;
  margin-left: 8px; vertical-align: middle;
}
.tag.person { background: #F4E8E5; color: #B8432F; }

/* Rank list */
.rank-list { display: flex; flex-direction: column; }
.rank-header {
  display: grid;
  grid-template-columns: 36px 1fr 220px 56px;
  gap: 14px; align-items: center;
  padding-bottom: 10px;
  border-bottom: 1.5px solid var(--ink);
  font-family: var(--sans); font-size: 10px;
  letter-spacing: .12em; text-transform: uppercase;
  color: var(--muted); font-weight: 500;
}
.rank-row {
  display: grid;
  grid-template-columns: 36px 1fr 220px 56px;
  align-items: center; gap: 14px;
  padding: 9px 0;
  border-bottom: 1px solid var(--wash);
}
.rank-row:last-child { border-bottom: none; }
.rank-num {
  font-family: var(--sans); font-size: 11px;
  color: var(--muted); text-align: right;
  font-variant-numeric: tabular-nums;
}
.rank-name { font-family: var(--serif); font-size: 16px; }
.rank-count {
  font-family: var(--sans); font-size: 12px;
  color: var(--muted); text-align: right;
  font-variant-numeric: tabular-nums;
}

/* Bar */
.bar-wrap {
  height: 6px; background: var(--wash);
  border-radius: 1px; position: relative;
}
.bar {
  position: absolute; left: 0; top: 0;
  height: 100%; border-radius: 1px;
  background: var(--ink); opacity: .4;
}
.bar.accent { background: var(--accent); opacity: .65; }
.bar.female { background: var(--accent); opacity: .5; }

/* Mobile */
@media (max-width: 768px) {
  .dash-grid { grid-template-columns: 1fr; }
  .panel.wide { grid-column: span 1; }
  .stats-bar { padding: 10px 20px; gap: 16px; }
  .site-nav { padding: 12px 20px; }
  .site-nav nav { display: none; }
}
  </style>
</head>
<body>

<nav class="site-nav">
  <a href="#cele-mai-intalnite" class="brand">Cum ne numim străzile</a>
  <nav>
    <a href="#cele-mai-intalnite">Cele mai întâlnite</a>
    <a href="#tematica">Tematică</a>
    <a href="#pe-cine-onoram">Pe cine onorăm</a>
    <a href="#recunoastere">Recunoaștere</a>
    <a href="#harta">Harta</a>
    <a href="#renumiri">Renumiri</a>
    <a href="#curiozitati">Curiozități</a>
    <a href="metodologie.html">Metodologie</a>
  </nav>
</nav>

{# Stats bar #}
{% set total_gendered = section1.total_persons_m + section1.total_persons_f %}
{% set male_pct = (section1.total_persons_m / total_gendered * 100) | round | int if total_gendered else 0 %}
{% set wikidata_total = section4.tier_counts.universal + section4.tier_counts.national + section4.tier_counts.local %}
<div class="stats-bar">
  <span><span class="stat-val">{{ "{:,.0f}".format(section1.total_streets).replace(",", ".") }}</span> adrese</span>
  <span class="stat-sep">·</span>
  <span><span class="stat-val">{{ section6.by_judet | length }}</span> județe</span>
  <span class="stat-sep">·</span>
  <span><span class="stat-val">{{ section3.total_m + section3.total_f }}</span> persoane</span>
  <span class="stat-sep">·</span>
  <span><span class="stat-val">{{ male_pct }}%</span> bărbați</span>
  <span class="stat-sep">·</span>
  <span>#1 bărbat: <span class="stat-val">{{ section1.top_men[0].full_name if section1.top_men else '—' }}</span>{% if section1.top_men %} · {{ section1.top_men[0].street_count }} str.{% endif %}</span>
  <span class="stat-sep">·</span>
  <span>#1 femeie: <span class="stat-val">{{ section1.top_women[0].full_name if section1.top_women else '—' }}</span>{% if section1.top_women %} · {{ section1.top_women[0].street_count }} str.{% endif %}</span>
  <span class="stat-sep">·</span>
  <span><span class="stat-val">{{ wikidata_total }}</span> cu Wikidata</span>
</div>

<div class="dash-grid">

{# PANEL: CELE MAI FRECVENTE (wide) #}
<div class="panel wide" id="cele-mai-intalnite">
  <div class="panel-header">
    <span class="panel-label">Cele mai frecvente</span>
    <div style="position:relative;">
      <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:14px;pointer-events:none;">⌕</span>
      <input id="s2-search" type="text" placeholder="Căutați un nume de stradă…"
        style="border:1.5px solid var(--rule);border-radius:3px;padding:7px 14px 7px 34px;font-family:var(--sans);font-size:13px;color:var(--ink);background:var(--bg);outline:none;width:280px;">
    </div>
  </div>
  <div class="chip-row" id="s2-judet-row">
    <span class="label">Județ</span>
    <button class="chip active" data-judet="all">Toate</button>
    {# Județ chips loaded by JS #}
  </div>
  <div style="font-family:var(--sans);font-size:12px;color:var(--muted);margin-bottom:12px;">
    <strong style="color:var(--ink);">Strada Principală</strong> · <strong id="s2-principal-count">—</strong> apariții · exclusă din scară
  </div>
  <div class="rank-list" id="s2-list">
    <div class="rank-header">
      <span></span><span>Nume</span><span>Frecvență relativă</span><span style="text-align:right">Apariții</span>
    </div>
    {# Populated by JS #}
  </div>
  <div style="font-family:var(--sans);font-size:11px;color:var(--muted);padding:10px 0 0;" id="s2-footer"></div>
</div>

{# PANEL: REPARTIȚIE TEMATICĂ (left) #}
{% set theme_total = section5.theme_dist | sum(attribute='count') %}
{% set theme_colors = ['#C04F35','#A0826A','#8BA888','#6E6E70','#B8A090','#3A3A3D','#DDDCD7'] %}
{% set ns = namespace(cumulative=0) %}
<div class="panel" id="tematica">
  <div class="panel-header">
    <span class="panel-label">Repartiție tematică</span>
    <span style="font-family:var(--sans);font-size:11px;color:var(--muted);">{{ "{:,.0f}".format(theme_total).replace(",", ".") }} clasificate</span>
  </div>
  <div style="display:flex;gap:32px;align-items:start;">
    <div style="position:relative;width:140px;height:140px;flex-shrink:0;">
      <div style="width:140px;height:140px;border-radius:50%;background:conic-gradient(
        {% for t in section5.theme_dist %}
        {% set pct = (t.count / theme_total * 100) | round(1) %}
        {{ theme_colors[loop.index0 % theme_colors|length] }} {{ ns.cumulative }}% {{ ns.cumulative + pct }}%{{ ',' if not loop.last }}
        {% set ns.cumulative = ns.cumulative + pct %}
        {% endfor %}
      );"></div>
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:78px;height:78px;background:var(--bg);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;">
        <div style="font-family:var(--serif);font-weight:500;font-size:18px;line-height:1;">{{ "{:,.0f}".format(theme_total).replace(",", ".") }}</div>
        <div style="font-family:var(--sans);font-size:9px;color:var(--muted);">total</div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:4px;flex:1;">
      {% for t in section5.theme_dist %}
      {% set pct = (t.count / theme_total * 100) | round(1) %}
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="width:10px;height:10px;border-radius:1px;background:{{ theme_colors[loop.index0 % theme_colors|length] }};flex-shrink:0;"></div>
        <span style="font-family:var(--sans);font-size:13px;flex:1;">{{ t.category }}</span>
        <span style="font-family:var(--sans);font-size:13px;font-weight:600;">{{ pct }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{# PANEL: SUBTIPURI NATURĂ (right) #}
{% set nature_ro = {
  'flower':'flori','tree':'copaci','water':'apă','plant':'plante',
  'bird':'păsări','sky':'cer','geography':'geografie','forest':'pădure',
  'meadow':'câmpie','season':'anotimpuri','animal':'animale',
  'weather':'vreme','fruit':'fructe','field':'câmp','hill':'deal',
  'orchard':'livadă','valley':'vale','peak':'vârf','mountain':'munte',
  'mountain_peak':'vârf de munte'
} %}
<div class="panel">
  <div class="panel-header">
    <span class="panel-label">Subtipuri · Natură</span>
  </div>
  {% set max_n = section5.nature_subtypes[0].n if section5.nature_subtypes else 1 %}
  {% for row in section5.nature_subtypes %}
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
    <span style="font-family:var(--sans);font-size:13px;flex:1;">{{ nature_ro.get(row.nature_type, row.nature_type) }}</span>
    <div class="bar-wrap" style="width:120px;height:5px;"><div class="bar" style="width:{{ (row.n / max_n * 100)|int }}%;background:#A0826A;opacity:.7;"></div></div>
    <span style="font-family:var(--sans);font-size:11px;color:var(--muted);width:28px;text-align:right;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: TOKENI IDEOLOGICI (left) #}
{% set ideo_ro = {
  'victory':'victorie','national_day':'zi națională','brotherhood':'frăție',
  'youth':'tinerețe','workers':'muncitori','unification':'unire',
  'triumph':'triumf','solidarity':'solidaritate','revolution':'revoluție',
  'republic':'republică','rebirth':'renaștere','progress':'progres',
  'peace':'pace','liberation':'eliberare','labor':'muncă',
  'independence':'independență','homeland':'patrie','glory':'glorie',
  'freedom':'libertate','fraternity':'frăternitate','equality':'egalitate',
  'emancipation':'emancipare','democracy':'democrație','cooperative':'cooperativă',
  'communist_press':'presă comunistă','commemorative':'comemorativ'
} %}
<div class="panel">
  <div class="panel-header">
    <span class="panel-label">Tokeni ideologici</span>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:8px;">
    {% for tok in section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:12px;padding:4px 11px;border:1px solid {{ 'var(--accent)' if tok.n > 30 else 'var(--rule)' }};border-radius:3px;color:{{ '#B8432F' if tok.n > 30 else 'var(--ink)' }};background:{{ '#FDF4F2' if tok.n > 30 else 'transparent' }};">
      {{ ideo_ro.get(tok.token, tok.token) }} <span style="color:var(--muted);font-size:10px;margin-left:4px;">{{ tok.n }}</span>
    </span>
    {% endfor %}
    {% if not section5.ideo_tokens %}
    <span style="font-family:var(--sans);font-size:13px;font-style:italic;color:var(--muted);">Subcategorii în curs de completare.</span>
    {% endif %}
  </div>
</div>

{# PANEL: ECART DE GEN (right) #}
<div class="panel" id="pe-cine-onoram">
  <div class="panel-header">
    <span class="panel-label">Ecart de gen</span>
    <span style="font-family:var(--sans);font-size:11px;color:var(--muted);">{{ section3.total_m + section3.total_f }} persoane clasificate</span>
  </div>
  <div style="display:flex;gap:28px;align-items:start;">
    <div>
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">Fiecare pătrat = 1 persoană</div>
      <div id="s3-gap-grid" style="display:grid;grid-template-columns:repeat(10,16px);gap:3px;width:196px;"></div>
      <div style="display:flex;gap:14px;margin-top:10px;font-family:var(--sans);font-size:11px;">
        <div style="display:flex;align-items:center;gap:6px;">
          <div style="width:10px;height:10px;border-radius:1px;background:var(--ink)"></div><span style="color:var(--muted)">Bărbat</span>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <div style="width:10px;height:10px;border-radius:1px;background:var(--accent)"></div><span style="color:var(--muted)">Femeie</span>
        </div>
      </div>
    </div>
    <div>
      <div style="font-family:var(--serif);font-weight:500;font-size:48px;line-height:1;letter-spacing:-.02em;margin-bottom:4px;">
        {{ section3.total_m }}<span style="font-size:26px;color:var(--muted);">/{{ section3.total_m + section3.total_f }}</span>
      </div>
      <div style="font-family:var(--sans);font-size:12px;color:var(--muted);">bărbați din total</div>
    </div>
  </div>
</div>

{# PANEL: TOP PERSOANE (wide) #}
<div class="panel wide">
  <div class="panel-header">
    <span class="panel-label">Top persoane onorate · număr de străzi</span>
  </div>
  <div class="rank-list" id="s3-tower">
    {% set max_count = section3.top_persons[0].street_count %}
    {% for p in section3.top_persons %}
    <div class="rank-row" style="grid-template-columns:200px 1fr 54px;">
      <span class="rank-name">
        {{ p.full_name }}
        {% if p.gender == 'F' %}<span style="display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-left:7px;vertical-align:middle;"></span>{% endif %}
      </span>
      <div class="bar-wrap">
        <div class="{{ 'bar accent' if loop.first else ('bar female' if p.gender == 'F' else 'bar') }}"
             style="width:{{ (p.street_count / max_count * 100)|int }}%"></div>
      </div>
      <span class="rank-count">{{ p.street_count }}</span>
    </div>
    {% endfor %}
  </div>
</div>

{# PANEL: PROFESII (left) #}
{% set prof_ro = {
  'writer':'scriitor','poet':'poet','politician':'politician',
  'voievod':'voievod','revolutionary':'revoluționar','military':'militar',
  'royalty':'rege / regină','scientist':'om de știință','painter':'pictor',
  'ruler':'conducător','historian':'istoric','composer':'compozitor',
  'engineer':'inginer','educator':'pedagog','clergy':'cleric',
  'philosopher':'filosof','actor':'actor','architect':'arhitect',
  'doctor':'medic','economist':'economist','jurist':'jurist',
  'linguist':'lingvist','mathematician':'matematician','lawyer':'avocat'
} %}
<div class="panel">
  <div class="panel-header">
    <span class="panel-label">Profesia persoanei onorate</span>
  </div>
  {% set max_prof = section3.profession_dist[0].n if section3.profession_dist else 1 %}
  {% for row in section3.profession_dist %}
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
    <span style="font-family:var(--sans);font-size:13px;flex:1;">{{ prof_ro.get(row.profession, row.profession) }}</span>
    <div class="bar-wrap" style="width:120px;height:5px;">
      <div class="bar" style="width:{{ (row.n / max_prof * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:11px;color:var(--muted);width:24px;text-align:right;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: EPOCI (right) #}
{% set era_ro = {
  'ancient':'antichitate','medieval':'medieval','premodern':'premodern (1700–1900)',
  '1848':'generația de la 1848','interwar':'interbelic (1900–1947)',
  'communist':'comunism (1947–1989)'
} %}
<div class="panel">
  <div class="panel-header">
    <span class="panel-label">Epoca în care a trăit</span>
  </div>
  {% set max_era = section3.era_dist[0].n if section3.era_dist else 1 %}
  {% for row in section3.era_dist %}
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
    <span style="font-family:var(--sans);font-size:13px;flex:1;">{{ era_ro.get(row.era, row.era or 'necunoscută') }}</span>
    <div class="bar-wrap" style="width:120px;height:5px;">
      <div class="bar" style="width:{{ (row.n / max_era * 100)|int }}%"></div>
    </div>
    <span style="font-family:var(--sans);font-size:11px;color:var(--muted);width:24px;text-align:right;">{{ row.n }}</span>
  </div>
  {% endfor %}
</div>

{# PANEL: RECUNOAȘTERE GLOBALĂ (left) #}
<div class="panel" id="recunoastere">
  <div class="panel-header">
    <span class="panel-label">Recunoaștere globală · Wikidata</span>
    <span style="font-family:var(--sans);font-size:11px;color:var(--muted);">{{ wikidata_total }} persoane</span>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:var(--rule);border:1px solid var(--rule);">
    <div style="background:var(--ink);color:#FAF8F3;padding:20px 16px;">
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--accent);margin-bottom:10px;">Universal</div>
      <div style="font-family:var(--serif);font-weight:500;font-size:40px;line-height:1;letter-spacing:-.02em;margin-bottom:4px;">{{ section4.tier_counts.universal }}</div>
      <div style="font-family:var(--sans);font-size:10px;color:#C9C9CB;">≥ 50 limbi Wikipedia</div>
    </div>
    <div style="background:var(--bg);padding:20px 16px;">
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted);margin-bottom:10px;">Național</div>
