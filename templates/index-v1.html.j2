    <span class="panel-label">Curiozități</span>
  </div>
  <div style="display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;border-bottom:1px solid var(--rule);padding-bottom:20px;margin-bottom:20px;">
    <div>
      <div style="font-family:var(--sans);font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--accent);margin-bottom:10px;">Comuna care a renunțat la nume</div>
      <div style="font-family:var(--serif);font-weight:500;font-size:22px;line-height:1.12;margin:0 0 10px;">Cioranii de Jos, Prahova</div>
      <p style="font-family:var(--sans);font-size:13px;line-height:1.6;color:var(--muted);max-width:500px;">
        Din {{ section8.ciorani.total }} de străzi,
        <strong style="color:var(--ink);">{{ section8.ciorani.numeric }} se cheamă printr-un număr</strong>.
        Strada 1. Strada 2. Strada {{ section8.ciorani.numeric }}.
        {% if section8.ciorani.total > section8.ciorani.numeric %}
        Una singură are un nume propriu-zis.
        {% endif %}
