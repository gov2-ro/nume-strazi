    <div style="text-align:right;">
      <span style="font-family:var(--serif);font-weight:500;font-size:{{ '64px' if section8.ciorani.numeric >= 100 else '80px' }};line-height:1;letter-spacing:-.03em;color:var(--accent);display:block;">{{ section8.ciorani.numeric }}</span>
      <span style="font-family:var(--serif);font-size:24px;color:var(--muted);display:block;">din {{ section8.ciorani.total }}</span>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:var(--rule);border:1px solid var(--rule);">

    {# Longest names #}
    <div style="background:var(--bg);padding:20px 18px;">
      <div class="panel-label" style="margin-bottom:12px;">Cea mai poetică</div>
      {% for item in section8.longest_names[:4] %}
      <div style="font-family:var(--serif);font-size:{{ [18,15,14,13][loop.index0] }}px;line-height:1.3;margin-bottom:{{ 10 if loop.index0 < 3 else 0 }}px;">
        {{ item.name }}
      </div>
      {% if not loop.last %}
      <div style="font-family:var(--sans);font-size:10px;color:var(--muted);margin-bottom:8px;">{{ item.char_count }} caractere</div>
      {% endif %}
      {% endfor %}
      {% if not section8.longest_names %}
      <p style="font-family:var(--sans);font-size:12px;font-style:italic;color:var(--muted);">Niciun nume lung identificat.</p>
      {% endif %}
    </div>

    {# Animal contest #}
    <div style="background:var(--bg);padding:20px 18px;">
      <div class="panel-label" style="margin-bottom:12px;">Concursul animalelor</div>
      {% if section8.animal_names %}
        {% set max_animal = section8.animal_names[0].n %}
        {% for row in section8.animal_names %}
        <div style="display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:{{ '1px solid var(--wash)' if not loop.last else 'none' }};">
          <span style="font-family:var(--sans);font-size:10px;color:var(--muted);width:16px;text-align:right;">{{ loop.index }}</span>
          <span style="font-family:var(--sans);font-size:13px;flex:1;">{{ row.animal_ro or row.name_normalized }}</span>
          <div class="bar-wrap" style="width:60px;height:4px;"><div class="bar" style="width:{{ (row.n / max_animal * 100)|int }}%;"></div></div>
          <span style="font-family:var(--sans);font-size:11px;color:var(--muted);width:22px;text-align:right;">{{ row.n }}</span>
        </div>
        {% endfor %}
      {% else %}
        <p style="font-family:var(--sans);font-size:12px;font-style:italic;color:var(--muted);">Termeni în curs de completare.</p>
      {% endif %}
    </div>

    {# Locally honored #}
    <div style="background:var(--bg);padding:20px 18px;">
      <div class="panel-label" style="margin-bottom:12px;">Onorat doar aici</div>
      {% for item in section8.local_honorees %}
      <div style="padding:8px 0;border-bottom:{{ '1px solid var(--wash)' if not loop.last else 'none' }};">
        <div style="font-family:var(--sans);font-size:13px;margin-bottom:2px;">
          <span style="display:inline-block;width:5px;height:5px;background:var(--accent);border-radius:50%;margin-right:5px;vertical-align:middle;"></span>
          {{ item.full_name }}
        </div>
        {% if item.profession %}
        <div style="font-family:var(--sans);font-size:10.5px;color:var(--muted);">{{ item.profession }}</div>
        {% endif %}
        <div style="font-family:var(--sans);font-size:10px;color:var(--muted);margin-top:2px;">{{ item.uat }} · {{ item.judet }}</div>
      </div>
      {% endfor %}
      {% if not section8.local_honorees %}
      <p style="font-family:var(--sans);font-size:12px;font-style:italic;color:var(--muted);">Persoane locale în curs de identificare.</p>
      {% endif %}
    </div>

  </div>
</div>

</div>{# end .dash-grid #}

