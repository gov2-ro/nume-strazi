# Copy to .env (gitignored) and fill in whichever provider you'll use.
# Only tools/llm_classify.py needs any of this — the ETL path uses no API keys.
# tools/llm_layer.py loads .env automatically; nothing needs exporting by hand.
#
# Check what resolves, and make one live call:
#     python3 tools/llm_layer.py
#     python3 tools/llm_layer.py --model deepseek-v4-flash

# Default model when --model is omitted. Both spellings are read (LLM_MODEL
# first, then LLM_model) because env vars are case-sensitive on Unix and it is
# an easy one to get wrong.
#

LLM_MODEL=deepseek-v4-flash

# Used only when neither LLM_MODEL nor --model is set: picks that provider's
# default from llm_layer.PROVIDERS. One of: deepseek | gemini | anthropic | openrouter
LLM_PROVIDER=deepseek

# Fill in the one(s) you use; leave the rest blank. llm_layer bridges these to
# the names the llm plugins expect (DEEPSEEK_API_KEY -> LLM_DEEPSEEK_KEY,
# GOOGLE_API_KEY -> LLM_GEMINI_KEY), which those plugins read at registration
# time — a key set later leaves the model invisible to llm.get_model().
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Note: a Google key with an IP allowlist will 403 from a new network — the
# error names the blocked address. Nothing in this repo routes through a proxy.
